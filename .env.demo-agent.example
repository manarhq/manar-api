# Variables the scripted demo agent (`pnpm demo:agent`) reads. It does NOT load
# the API's .env (Gate 0 finding R9): an agent process must never hold the
# API's secrets. Every value below has a local-stack default in
# scripts/demo-agent.ts; export only what differs.
MANAR_DEMO_API_ENDPOINT=http://localhost:3000
MANAR_DEMO_MTLS_ENDPOINT=https://127.0.0.1:3443
MANAR_DEMO_CREDENTIALS_FILE=.manar-demo/tenant-credentials.json
MANAR_DEMO_IDENTITY_PASSPHRASE=
KEYCLOAK_BASE_URL=http://localhost:8081
DEMO_SOC_TOOLS_BASE_URL=http://localhost:3101
DEMO_TOOLS_API_KEY=manar-dev-demo-tools-key
