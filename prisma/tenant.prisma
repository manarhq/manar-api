// Tenant DB schema.
//
// Every tenant gets a fully isolated Postgres database generated from this
// schema (see TenantDatabaseManager.provisionTenant). Phase 2 shipped this
// file with datasource/generator blocks only and no models — deliberately,
// to avoid inventing placeholder domain models just to have "something to
// test" (isolation was proven structurally instead, see
// docs/tenant-isolation.md). Phase 3 (Human Authentication) adds the first
// real models: a local projection of each tenant's Keycloak-authenticated
// users and their coarse role assignments — see docs/human-auth.md.
// Phase 4 (Agent Identity & Enrollment) adds agents as independent security
// principals with X.509-based workload identity — see docs/agent-identity.md.
datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/tenant-client"
  // See prisma/control.prisma's generator block for why this is forced to
  // cjs — this project is CommonJS, Prisma 7 defaults to ESM output.
  moduleFormat = "cjs"
}

/// The eight application roles (Section 11 of the master prompt). Values
/// must match `src/auth/roles.ts`'s `ROLES` constant, and the Keycloak
/// realm role names `TenantProvisioningService` seeds for every tenant,
/// character-for-character — see that file's doc comment for why there is
/// deliberately no translation layer between the three.
enum Role {
  TENANT_OWNER
  SECURITY_ADMIN
  AI_GOVERNANCE_MANAGER
  SOC_OPERATOR
  APPROVER
  AUDITOR
  DEVELOPER
  READ_ONLY
}

/// A local projection of a Keycloak-authenticated human identity — never a
/// credential store (Manar's own code never stores or sees passwords;
/// Keycloak owns credentials entirely). Rows are found-or-created by
/// `JwtAuthGuard` the first time a given `keycloakSubject` (the JWT `sub`
/// claim) is seen for this tenant.
model UserProfile {
  id              String @id @default(uuid())
  keycloakSubject String @unique

  email       String
  displayName String

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  roleBindings RoleBinding[]

  /// Phase 4: agents/enrollment tokens this user has created — "createdBy"
  /// is a free-text-adjacent audit trail elsewhere in this schema (see
  /// RoleBinding.grantedBy's doc comment for the precedent), but here it's
  /// a real FK since agent creation is always attributable to an
  /// authenticated Manar user (JwtAuthGuard's AuthContext), never a
  /// Keycloak-side actor.
  createdAgents           Agent[]
  createdEnrollmentTokens AgentEnrollmentToken[]

  /// Phase 5: every Task ultimately traces back to a human requester — even
  /// a delegated child Task's `requesterId` is the *root* task's original
  /// requester (see docs/task-delegation.md), never the delegating agent
  /// (Task.requesterId is a UserProfile FK; an agent has no UserProfile
  /// row). This is what makes the Human → Task → Agent → Task → Agent
  /// chain fully reconstructable per Section 20.
  requestedTasks Task[]

  /// Phase 6: every PolicyVersion (DRAFT or PUBLISHED) records the human
  /// who authored it — see PolicyVersion's doc comment.
  authoredPolicyVersions PolicyVersion[]

  /// Phase 8: every ApprovalDecision this user has made (APPROVE/DENY) —
  /// see that model's doc comment.
  approvalDecisions ApprovalDecision[]

  /// Kill-switch phase (Section 32): every tenant/agent-group/agent/tool
  /// `KillSwitch` this user has activated/deactivated — see that model's
  /// doc comment.
  killSwitchActivations   KillSwitch[] @relation("KillSwitchActivations")
  killSwitchDeactivations KillSwitch[] @relation("KillSwitchDeactivations")

  /// Phase 12a: `WebhookEndpoint`s this user registered — see that model's doc comment.
  createdWebhookEndpoints WebhookEndpoint[] @relation("WebhookEndpointCreations")

  /// Phase 15a (Section 70): `Incident`s this user created — see that model's doc comment.
  createdIncidents Incident[] @relation("IncidentCreations")

  /// Release 2026-11-11 (brief §3.1): the AI-system inventory's
  /// human-attribution edges. `ownedAiSystems` is the accountable-owner
  /// relation the overview's overdue-review queue reads; the other four are
  /// provenance trails (who created a record, who changed it, who linked an
  /// asset to it, who moved it through its lifecycle) — see `AiSystem`'s
  /// own doc comment.
  ownedAiSystems         AiSystem[]                @relation("AiSystemOwnership")
  createdAiSystems       AiSystem[]                @relation("AiSystemCreations")
  aiSystemVersionChanges AiSystemVersion[]         @relation("AiSystemVersionAuthorship")
  aiSystemAgentLinks     AiSystemAgentLink[]       @relation("AiSystemAgentLinks")
  aiSystemToolLinks      AiSystemToolLink[]        @relation("AiSystemToolLinks")
  aiSystemTransitions    AiSystemStateTransition[] @relation("AiSystemTransitions")

  @@map("user_profiles")
}

/// Coarse role assignment, checked by `RolesGuard`/`@RequireRole(...)`.
/// Fine-grained, resource-scoped authorization is a later phase (OpenFGA,
/// Phase 5) — not built here. A user can hold multiple roles.
model RoleBinding {
  id     String      @id @default(uuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [id])

  role Role

  grantedAt DateTime @default(now())
  /// Free-text identifier of who/what granted this role (a Keycloak admin
  /// username, or "system:bootstrap" for the first role a newly-seen user
  /// is granted). Not a foreign key to UserProfile — the granter need not
  /// be a Manar user at all (e.g. a Keycloak-side realm admin).
  grantedBy String

  @@unique([userId, role])
  @@map("role_bindings")
}

/// Agent lifecycle state (Phase 4, Section 13-17 of the master prompt).
/// PENDING_ENROLLMENT: created by a human, no working certificate yet.
/// ACTIVE: has passed enrollment (POST /agents/enroll) with a valid,
/// unrevoked certificate. REVOKED: `CertificateAuthorityService.revoke`
/// ran — the agent's certificate no longer authenticates on the mTLS
/// surface (AgentMtlsGuard checks this on every request, not just at TLS
/// handshake time — see docs/agent-identity.md). KILLED is reserved for a
/// later, dedicated kill-switch phase (Section 32) — not set by anything
/// in this phase, kept here now so that later phase avoids a destructive
/// migration to extend this enum.
enum AgentStatus {
  PENDING_ENROLLMENT
  ACTIVE
  REVOKED
  KILLED
}

/// An agent: an independent security principal with workload identity
/// based on asymmetric crypto + an X.509 certificate (never a shared
/// secret/API key). `identifier` is this agent's SPIFFE-like identity URI
/// (`agent://<tenantSlug>/<slug>`) — the exact string
/// `CertificateAuthorityService` requires an enrollment CSR's Subject
/// Alternative Name to match before it will ever ask OpenBao to sign
/// anything, and the same string `AgentMtlsGuard` looks up an mTLS
/// request's verified client certificate by. Unique per tenant database,
/// so unique globally in effect (Phase 2's isolation model: there is no
/// shared table for two tenants' agents to collide in).
model Agent {
  id          String      @id @default(uuid())
  slug        String      @unique
  identifier  String      @unique
  displayName String
  status      AgentStatus @default(PENDING_ENROLLMENT)

  /// Unused until Phase 5+ (agent capabilities/task scoping is explicitly
  /// out of scope this phase) — kept minimal (an empty object) rather than
  /// omitted so that phase doesn't need a destructive migration to add it.
  capabilities Json @default("{}")

  createdAt DateTime    @default(now())
  createdBy String
  creator   UserProfile @relation(fields: [createdBy], references: [id])

  groupMemberships AgentGroupMembership[]
  enrollmentTokens AgentEnrollmentToken[]
  certificates     AgentCertificate[]

  /// Phase 5: tasks currently assigned to this agent — an agent's *only*
  /// source of authority (Section 18: agents start with effectively zero
  /// useful permanent authority; `capabilities` above stays unused this
  /// phase too). See docs/authorization-model.md.
  assignedTasks Task[]

  /// Phase 7b: every tool call this agent has actually made (or attempted)
  /// through `CredentialBrokerService` — see `ToolInvocation`'s own doc
  /// comment.
  toolInvocations ToolInvocation[]

  /// Phase 8: every ApprovalRequest/AuthorizationGrant naming this agent as
  /// the one that would (or did) execute the pending action — see those
  /// models' own doc comments.
  approvalRequests    ApprovalRequest[]
  authorizationGrants AuthorizationGrant[]

  /// Phase 10b: every short-lived elevated-risk flag set for this agent by
  /// a detected prompt-injection attempt — see `AgentRiskFlag`'s own doc
  /// comment.
  riskFlags AgentRiskFlag[]

  /// Release 2026-11-11: the `AiSystem`s this agent has been declared to
  /// serve. Additive and reversible — linking never rewrites this agent's
  /// own `createdBy`/`capabilities` (see `AiSystemAgentLink`).
  aiSystemLinks AiSystemAgentLink[]

  /// ADR-0009: present once this agent has ever been quarantined.
  quarantine AgentQuarantine?

  /// How the agent authenticates (docs/cloud-agents.md).
  kind         AgentKind          @default(WORKLOAD)
  cloudBinding CloudAgentBinding?
  /// docs/edge.md: hostnames this agent may reach through the Manar edge proxy.
  egressRules AgentEgressRule[]

  @@map("agents")
}

/// WORKLOAD: an X.509 client certificate on the mTLS listener (enrollment).
/// CLOUD: runs in a vendor's cloud (Copilot Studio, ChatGPT) and calls the
/// public MCP endpoint with an OAuth access token from the tenant's realm.
enum AgentKind {
  WORKLOAD
  CLOUD
}

enum CloudAgentPlatform {
  COPILOT_STUDIO
  CHATGPT
}

/// The OAuth side of a CLOUD agent (docs/cloud-agents.md). A token reaches
/// this agent only when its audience is the agent's MCP URL (put there by
/// the `oauthScope` client scope's audience mapper) and, for a
/// pre-registered client, its `azp` is `oauthClientId`.
model CloudAgentBinding {
  id       String             @id @default(uuid())
  agentId  String             @unique
  agent    Agent              @relation(fields: [agentId], references: [id])
  platform CloudAgentPlatform

  /// Keycloak clientId of the pre-registered client (Copilot Studio). Null
  /// for ChatGPT, which registers its own client (DCR).
  oauthClientId String? @unique
  /// Keycloak client scope whose audience mapper adds the MCP URL.
  oauthScope    String  @unique
  /// The standing task every tools/call of this agent runs under.
  taskId        String
  /// Keycloak object ids Manar created at connect ({ clientUuid?, scopeId, roleId, mapperId? });
  /// disconnect deletes these, never objects found by name.
  keycloakIds   Json    @default("{}")

  /// ChatGPT: the first eligible self-registered client waits here until a tenant admin confirms
  /// it (POST /cloud-agents/:id/oauth-client/confirm); `pendingClient` holds what was checked
  /// (registration time, redirect URIs, grants).
  pendingClientId String?
  pendingClient   Json?
  pendingSince    DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cloud_agent_bindings")
}

/// Minimal this phase — membership only, no group-based policy yet (that's
/// Phase 5+, alongside agent capabilities/task scoping).
model AgentGroup {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())

  memberships AgentGroupMembership[]

  @@map("agent_groups")
}

model AgentGroupMembership {
  id String @id @default(uuid())

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id])

  groupId String
  group   AgentGroup @relation(fields: [groupId], references: [id])

  addedAt DateTime @default(now())

  @@unique([agentId, groupId])
  @@map("agent_group_memberships")
}

/// A single-use enrollment token (Section 14). The raw token is only ever
/// returned once, at creation time (`POST /agents/:id/enrollment-tokens`'s
/// response) — never stored or retrievable again. `tokenHash` is what's
/// persisted (see `src/agents/enrollment-token.util.ts` for the hashing
/// scheme), so a control/tenant DB compromise alone can't be used to
/// enroll an agent. `expiresAt` is short (15 minutes — see
/// `AgentsService.ENROLLMENT_TOKEN_TTL_MS`); `usedAt` enforces single-use:
/// once set, a second enrollment attempt with the same token is rejected
/// even if it somehow leaked.
model AgentEnrollmentToken {
  id String @id @default(uuid())

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id])

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime    @default(now())
  createdBy String
  creator   UserProfile @relation(fields: [createdBy], references: [id])

  @@map("agent_enrollment_tokens")
}

/// Metadata for a certificate `CertificateAuthorityService` has issued.
/// Never stores the private key (it never leaves the enrolling agent — see
/// packages/sdk-node) or the full certificate PEM (OpenBao is the system
/// of record for the certificate material itself; this row is what lets
/// `AgentMtlsGuard` check "is this specific serial revoked" without a
/// round-trip to OpenBao on every mTLS request — defense in depth beyond
/// the TLS layer's own chain validation, since a cert can be individually
/// revoked before its `notAfter`).
model AgentCertificate {
  id String @id @default(uuid())

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id])

  /// Canonical form: uppercase hex, no separators (see
  /// `certificate-authority.service.ts`'s serial-number normalization doc
  /// comment for why this differs from OpenBao's own colon-separated
  /// format).
  serialNumber String @unique
  subject      String

  notBefore DateTime
  notAfter  DateTime

  revokedAt        DateTime?
  revocationReason String?
  /// When OpenBao confirmed the revocation. `revokedAt` is set first (the
  /// mTLS guard reads it), so a row with `revokedAt` set and this null is a
  /// CA revocation still owed; `CertificateAuthorityService.revoke` retries it.
  caRevokedAt      DateTime?

  createdAt DateTime @default(now())

  @@map("agent_certificates")
}

/// Task lifecycle state (Phase 5, Sections 18-20). A new task goes straight
/// to ACTIVE at creation — there is no approval step yet (Phase 6/8), so
/// PENDING is never actually set by anything this phase; it's kept in the
/// enum now (rather than added later) for the same reason `AgentStatus.KILLED`
/// was kept unused ahead of its own phase — avoids a destructive migration
/// once approvals land. EXPIRED/COMPLETED are likewise not transitioned to
/// by any code this phase: expiry is enforced by comparing `expiresAt`
/// against `now` at authorization time, not by a background job flipping
/// status (see docs/authorization-model.md — this is deliberate, it's what
/// the "expired task denies even though its OpenFGA tuples still exist"
/// test proves). REVOKED is the one status this phase's code actually
/// sets (`POST /tasks/:id/revoke`), and is central to the revocation-cascade
/// invariant: revoking a task must immediately invalidate every descendant
/// task's authorization, enforced by AuthorizationService walking the live
/// ancestor chain on every check — never by cascading a write to
/// descendants (Section 20).
enum TaskStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  COMPLETED
}

/// A narrowly-scoped, expiring grant of authority to exactly one agent
/// (Sections 18-20 of the master prompt) — the *only* way an agent ever
/// gets to do anything: agents start with zero permanent authority
/// (`Agent.capabilities` stays an unused empty object forever), and every
/// action an agent takes is authorized against the task it's currently
/// assigned to, never against the agent itself.
///
/// `allowedToolActions`/`allowedResourceSelectors`/`forbiddenActions` are
/// the human/audit-readable record of what was granted — Postgres columns,
/// queryable/diffable in the ordinary way. The *enforcement* substrate
/// `AuthorizationService` actually checks against is a mirrored set of
/// OpenFGA relationship tuples, written at task-creation/delegation time by
/// `TaskGrantSyncService` (see docs/authorization-model.md for the full
/// modeling rationale and why these are kept in sync rather than treated as
/// two independent sources of truth for the same decision).
///
/// `parentTaskId` is the self-referencing edge `AuthorizationService` walks
/// (recursively, on every authorization check — Section 20's real-time
/// revocation-cascade mechanism) to confirm every ancestor task is still
/// ACTIVE/unexpired/under its own execution limit. `TaskDelegation` exists
/// *alongside* this FK purely to make the delegation chain queryable/
/// auditable as a first-class row without walking the self-FK — see that
/// model's own doc comment.
model Task {
  id          String  @id @default(uuid())
  name        String
  description String?

  /// The human who ultimately requested this task. For a root task, the
  /// human who called `POST /tasks`. For a *delegated* (child) task, this
  /// is deliberately still the root task's original requester (resolved by
  /// walking `parentTaskId` to the top), never the delegating agent — an
  /// agent has no `UserProfile` row to point this FK at, and Section 20's
  /// full reconstructable chain (Human → Task → Agent → Task → Agent → …)
  /// depends on every task in the chain tracing back to the same
  /// originating human. See docs/task-delegation.md.
  requesterId String
  requester   UserProfile @relation(fields: [requesterId], references: [id])

  /// The *only* agent that may exercise this task's grants — permission
  /// flows through the task, never attached to the agent directly (Section
  /// 18). `AgentMtlsGuard`-resolved `AgentContext.agent.id` must match this
  /// exactly before `AuthorizationService` even reaches OpenFGA (step 1 of
  /// the authorize pipeline).
  assignedAgentId String
  assignedAgent   Agent  @relation(fields: [assignedAgentId], references: [id])

  /// Self-referencing edge for the ancestor chain (see model doc comment).
  /// Null for a root task.
  parentTaskId String?
  parentTask   Task?   @relation("TaskParent", fields: [parentTaskId], references: [id])
  childTasks   Task[]  @relation("TaskParent")

  /// `{ toolId, actionId }[]` — the set of tool actions this task may
  /// invoke. Crossed with `allowedResourceSelectors` (matched by `toolId`)
  /// at tuple-write time to produce the concrete grant set — see
  /// `src/authorization/grant-triples.ts`.
  allowedToolActions Json @default("[]")

  /// `{ toolId, pattern }[]` — the resources each tool action above may
  /// touch. `pattern` is either a literal resource identifier or the
  /// literal wildcard string `"*"` ("any resource for this tool action") —
  /// this phase deliberately does not implement glob/prefix pattern
  /// matching (that's real policy-engine territory, Phase 6/8's scope, not
  /// this phase's relationship-authorization engine); see
  /// docs/authorization-model.md's "known limitation" section.
  allowedResourceSelectors Json @default("[]")

  /// `{ toolId, actionId }[]` — explicit denies that win over
  /// `allowedToolActions` even for an otherwise-matching grant (checked
  /// before OpenFGA is ever called — step 4 of the authorize pipeline —
  /// *and* mirrored into OpenFGA's own tuples as a `but not` exclusion, so
  /// the deny is enforced from both angles, not just the faster app-layer
  /// short-circuit).
  forbiddenActions Json @default("[]")

  status TaskStatus @default(ACTIVE)

  startsAt       DateTime  @default(now())
  expiresAt      DateTime
  maxExecutions  Int?
  /// Incremented atomically (a single conditional `UPDATE`, closing the
  /// same race `AgentEnrollmentToken`'s single-use claim closes — see
  /// `AgentsService.enroll`'s doc comment) on every ALLOW decision. Never
  /// decremented; there is no notion of "returning" a used execution.
  executionCount Int       @default(0)

  /// 0-100, conservative default. Not enforced by anything this phase (no
  /// risk scoring yet — Phase 6/8) — captured now so that phase doesn't
  /// need a destructive migration to add it, matching this codebase's
  /// established precedent (e.g. `Tenant.residency` in Phase 2).
  riskCeiling Int @default(20)

  /// The pack this task runs (e.g. `it-helpdesk`), or null for a customer's own agent. A
  /// pack-bound task acts only while staff have that pack enabled for the tenant
  /// (`TenantCatalog`, src/platform/catalog.*). Delegated children inherit it.
  packId String?

  createdAt DateTime @default(now())

  delegationsAsParent TaskDelegation[] @relation("DelegationParent")
  delegationAsChild   TaskDelegation?  @relation("DelegationChild")

  /// Phase 7b: every tool call actually attempted under this task — see
  /// `ToolInvocation`'s own doc comment.
  toolInvocations ToolInvocation[]

  /// Phase 8: every ApprovalRequest/AuthorizationGrant issued for an
  /// action under this task — see those models' own doc comments.
  approvalRequests    ApprovalRequest[]
  authorizationGrants AuthorizationGrant[]

  @@map("tasks")
}

/// Exists purely to make the delegation chain queryable/auditable as a
/// first-class row independent of walking `Task.parentTaskId` — kept thin
/// per the design spec ("exists mainly to make the delegation chain
/// queryable/auditable... keep it thin"). `Task.parentTaskId` (set on the
/// child at creation time) is what `AuthorizationService` actually walks at
/// authorization-check time; this table is not consulted on that hot path.
model TaskDelegation {
  id String @id @default(uuid())

  parentTaskId String
  parentTask   Task @relation("DelegationParent", fields: [parentTaskId], references: [id])

  /// One parent may delegate to many children over time, but each child
  /// task has exactly one delegation record (it has exactly one
  /// `parentTaskId`) — `@unique` makes that structural, not just a
  /// convention.
  childTaskId String @unique
  childTask   Task   @relation("DelegationChild", fields: [childTaskId], references: [id])

  createdAt DateTime @default(now())

  @@map("task_delegations")
}

/// A `PolicyVersion`'s lifecycle (Phase 6, Sections 21-22). A new version
/// always starts DRAFT — never enforced by `PolicyEngine` (see that
/// module's doc comment) until it's explicitly PUBLISHED via `POST
/// /policies/:id/versions/:versionId/publish`. There is no third
/// state: a published version is never un-published, edited, or deleted —
/// superseding one always means publishing a *new* version (`version`
/// n+1), never mutating this one in place (see PolicyVersion's own doc
/// comment).
enum PolicyVersionStatus {
  DRAFT
  PUBLISHED
}

/// A named, versioned policy — Phase 6's deterministic org-defined
/// restriction layered *on top of* an already-OpenFGA-permitted action
/// (see docs/policy-model.md and docs/authorization-model.md for how this
/// relates to Phase 5's task-scope authorization, which this phase does
/// NOT re-decide). `name` is unique per tenant database, so effectively
/// globally unique (Phase 2's per-tenant database isolation model — see
/// docs/tenant-isolation.md).
///
/// A `Policy` row itself carries no rule content — that lives entirely on
/// its `PolicyVersion`s (immutable once published). "The policy's current
/// content" always means "the latest PUBLISHED PolicyVersion for this
/// Policy" (`PolicyEngine.evaluate` resolves this per policy, per tenant,
/// on every authorization check — see that module's doc comment for why
/// this is a live per-request DB read rather than a cached snapshot this
/// phase).
model Policy {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())

  versions PolicyVersion[]

  @@map("policies")
}

/// One immutable, content-addressed snapshot of a `Policy`'s rule set
/// (Sections 21-22 — "GUI/YAML/JSON must manipulate the same underlying
/// model; published versions are immutable"). `content` is the declarative
/// rule set this version represents — see docs/policy-model.md for the
/// schema (`src/policy/policy-content.schema.ts`'s `PolicyContentSchema`)
/// and `src/policy/policy-content-codec.ts` for the YAML⇄JSON round-trip
/// that produces it identically regardless of which format an author
/// submitted.
///
/// **Published versions are never mutated or deleted** — there is
/// deliberately no update/delete endpoint for one at all (see
/// `src/policy/policy.controller.ts`'s doc comment); editing a published
/// policy always means creating version n+1 via `POST
/// /policies/:id/versions`, and a rollback is likewise a *new* version
/// (n+1) whose `content` happens to match an older version's — never an
/// in-place revert — with `reason` explicitly saying so and
/// `previousVersionId` still pointing at the version immediately before it
/// in this policy's chain (not at the older version being rolled back to),
/// so the full chain stays linear and auditable end to end.
///
/// `version` is a monotonically increasing integer, unique per `policyId`
/// (`@@unique([policyId, version])`) — the *n*-th version ever created for
/// this policy, DRAFT or PUBLISHED alike; `PolicyEngine` only ever
/// consults the PUBLISHED one with the highest `version`.
model PolicyVersion {
  id String @id @default(uuid())

  policyId String
  policy   Policy @relation(fields: [policyId], references: [id])

  version Int
  status  PolicyVersionStatus @default(DRAFT)

  /// The declarative rule set itself — see docs/policy-model.md. Validated
  /// against `PolicyContentSchema` before this row is ever written
  /// (`PolicyService`); `PolicyEngine` re-validates on every read anyway
  /// (fail-closed — see that module's doc comment on why "can't parse
  /// stored content" is a genuine failure, distinct from "no rule
  /// matched").
  content Json

  /// sha256 hex of `content` after deterministic canonicalization (key
  /// order does not affect this value — see
  /// `src/policy/policy-content-codec.ts`'s `computeContentHash`). Proves a
  /// YAML submission and its JSON equivalent produce byte-identical stored
  /// intent, and lets a caller cheaply confirm "is this the version I
  /// think it is" without diffing the full `content` blob.
  contentHash String

  authorId String
  author   UserProfile @relation(fields: [authorId], references: [id])

  /// Free-text: why this version was created (a normal edit's rationale,
  /// or an explicit "Rollback to version N" for a rollback — see model doc
  /// comment). Optional for a policy's very first version.
  reason String?

  /// Self-FK to the version immediately preceding this one in this
  /// policy's chain at creation time (null only for a policy's first
  /// version) — *always* the chain predecessor, even for a rollback (whose
  /// `content` is copied from some *older*, not-necessarily-immediate
  /// version — see model doc comment). This is what keeps the full
  /// version history a single unbroken, auditable chain regardless of how
  /// many rollbacks occur.
  previousVersionId String?
  previousVersion   PolicyVersion?  @relation("PolicyVersionChain", fields: [previousVersionId], references: [id])
  supersededBy      PolicyVersion[] @relation("PolicyVersionChain")

  /// Set exactly once, the moment `POST
  /// /policies/:id/versions/:versionId/publish` transitions this row
  /// DRAFT → PUBLISHED. Null for a DRAFT.
  publishedAt DateTime?

  createdAt DateTime @default(now())

  /// Phase 8: an ApprovalRequest/AuthorizationGrant may record which
  /// PolicyVersion was published at the moment it was produced — nullable
  /// on both, since a APPROVAL_REQUIRED decision can also come purely from
  /// RiskEngine's score exceeding `task.riskCeiling` with no policy rule
  /// having matched at all (see `AuthorizationService`'s
  /// `risk_ceiling_exceeded` reason) — see those models' own doc comments.
  approvalRequests    ApprovalRequest[]
  authorizationGrants AuthorizationGrant[]

  @@unique([policyId, version])
  @@map("policy_versions")
}

/// Which wire protocol `ToolProtocolAdapter` implementation
/// `CredentialBrokerService` dispatches a `Tool`'s invocations to (Phase
/// 7b, Sections 33-35). `HTTP` -> `HttpToolAdapter` (a real outbound HTTP
/// call to `Tool.baseEndpoint`). `MCP` -> `McpToolAdapter` (a real Model
/// Context Protocol client, connecting to `Tool.baseEndpoint` as an MCP
/// server URL) — both protocols go through the *identical*
/// `CredentialBrokerService`/`AuthorizationService` pipeline; there is no
/// separate, weaker path for MCP. See docs/tool-gateway.md and
/// docs/mcp.md. `MICROSOFT` -> `MicrosoftToolAdapter` (Phase 2, ADR-0004):
/// Graph or Defender for Endpoint via an OAuth2 client-credentials token,
/// actions from the fixed catalog in `src/tools/microsoft-actions.ts`.
/// `GITLAB` -> `GitLabToolAdapter` (ADR-0012): one GitLab project over REST
/// v4 with a project access token, catalog in `src/tools/gitlab-actions.ts`.
enum ToolProtocol {
  HTTP
  MCP
  MICROSOFT
  GITLAB
}

/// A registered tool a task's grants may authorize an agent to call —
/// Sections 33-35's first-class tool registry (there was none before this
/// phase; `toolId`/`actionId` were opaque, caller-supplied strings
/// throughout Phase 5/6 — see docs/authorization-model.md's "out of scope"
/// note). `name` is unique per tenant database (Phase 2's per-tenant
/// isolation model — see docs/tenant-isolation.md), and is what a Task's
/// `allowedToolActions[].toolId`/`AuthorizeRequest.toolId` are expected to
/// match against once resolved by `CredentialBrokerService` — OpenFGA/the
/// policy engine still treat `toolId` as an opaque string for their own
/// checks (unchanged this phase, see docs/authorization-model.md), this
/// registry is what `POST /agent/v1/tools/invoke` resolves it against
/// *after* that authorization decision already came back ALLOW.
model Tool {
  id          String  @id @default(uuid())
  name        String  @unique
  /// Free text (e.g. `SIEM`/`EDR`/`IAM`/`FIREWALL`) -- a category label
  /// for human/audit readability only, never matched against by any
  /// authorization or risk logic.
  type        String
  vendor      String?
  description String?

  /// Base URL (`HTTP` protocol) or MCP server URL (`MCP` protocol) this
  /// tool's adapter connects to.
  baseEndpoint String
  protocol     ToolProtocol

  /// A `SecretReferenceDescriptor` (`{ provider, reference }` -- reuses
  /// Phase 2's `SecretProvider` interface, see
  /// `src/database/secret-provider.ts`) naming where this tool's
  /// credential actually lives. `CredentialBrokerService` resolves this
  /// through whichever provider it names (`ENV` or `OPENBAO` this phase)
  /// at invocation time -- the resolved credential value is never itself
  /// stored here, logged, or returned to any caller.
  credentialReference Json

  /// A disabled tool fails every invocation attempt cleanly (Section
  /// 35's explicit "disabled tool -> invocation fails even if
  /// authorization would otherwise allow it" requirement) --
  /// `CredentialBrokerService` checks this *after* `AuthorizationService`
  /// has already ALLOWed, since tool enablement is an operational
  /// concern, not an authorization decision.
  enabled Boolean @default(true)

  /// Free-form operator metadata (e.g. environment, owning team) -- never
  /// interpreted by any code this phase.
  metadata Json @default("{}")

  createdAt DateTime @default(now())

  actions      ToolAction[]
  invocations  ToolInvocation[]

  /// Release 2026-11-11: the `AiSystem`s this tool has been declared to
  /// serve — see `AiSystemToolLink`.
  aiSystemLinks AiSystemToolLink[]

  @@map("tools")
}

/// One invocable action on a `Tool` -- what `AuthorizeRequest.actionId`
/// and `POST /agent/v1/tools/invoke`'s `actionId` both resolve against.
/// `riskBaseScore`/`mutating`/`destructive` are the *real* per-action risk
/// signal `RiskEngine.score` looks up starting this phase, replacing
/// Phase 6's placeholder `actionId` keyword heuristic entirely (see
/// docs/policy-model.md's now-superseded "destructive-keyword heuristic"
/// section and `src/risk/risk-engine.service.ts`).
/// Phase 15a (Section 53) -- a tool action's data-sensitivity tag, mirrored
/// as a plain TS/Zod artifact in `src/common/data-classification.ts` (the
/// two must be kept in sync by hand, the same convention `Role`/`ROLES`
/// already establishes). Ordered least-to-most sensitive. Threaded through
/// three independent enforcement points -- none of them hardcoded to
/// auto-deny on `RESTRICTED`, since that's what `PolicyEngine` rules are
/// for:
///
///   1. `PolicyEngine`'s rule schema gains an optional
///      `resourceClassification` match condition
///      (`src/policy/policy-content.schema.ts`) so a policy author *can*
///      express "deny/require-approval for RESTRICTED actions" -- see
///      docs/data-classification.md.
///   2. `RiskEngine.score` adds a classification-based contributor to its
///      deterministic sum (`src/risk/risk-engine.service.ts`).
///   3. `AiAdvisoryClient`'s residency gate (Phase 12a's
///      `allowExternalAi` check) gains a second, independent check: a
///      `RESTRICTED` action's data is never sent to an external AI
///      provider, regardless of the tenant's `allowExternalAi` flag (see
///      that class's `residencyAllows`).
enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

model ToolAction {
  id          String  @id @default(uuid())
  toolId      String
  tool        Tool    @relation(fields: [toolId], references: [id])
  name        String
  description String?

  /// Phase 15a (Section 53) -- see `DataClassification`'s doc comment.
  /// Defaults to `INTERNAL`, not `PUBLIC` -- the safer default for any
  /// `ToolAction` row (including ones written before this phase existed,
  /// backfilled by this migration) that never explicitly declared a
  /// classification.
  classification DataClassification @default(INTERNAL)

  /// 0-100 -- this action's baseline risk contribution, looked up by
  /// `RiskEngine.score` and added to its deterministic sum (see
  /// docs/policy-model.md).
  riskBaseScore Int

  /// JSON Schema (plain, not a serialized Zod schema -- Zod schemas
  /// aren't JSON-serializable; JSON Schema is the interoperable, storable
  /// choice, and is what `HttpToolAdapter` validates
  /// `params` against via `ajv` before ever dispatching a request -- see
  /// docs/tool-gateway.md). Optional: a tool action with no meaningful
  /// input (e.g. a zero-argument read) may omit it, in which case no
  /// input validation is performed.
  inputSchema  Json?
  /// JSON Schema describing this action's expected result shape --
  /// documentation/contract only this phase, never validated against
  /// (there is no output-validation requirement in the design spec).
  outputSchema Json?

  /// Whether this action changes state on the target tool -- a real
  /// `RiskEngine`/policy-authoring signal (unlike Phase 6's deleted
  /// keyword heuristic, this is operator-declared truth, not guessed from
  /// the action's name).
  mutating Boolean @default(false)
  /// Whether this action is hard/impossible to reverse (e.g.
  /// `isolate_host`, `delete_user`) -- a stronger signal than `mutating`
  /// alone; both feed `RiskEngine.score` independently (see that
  /// service's doc comment for the exact point values).
  destructive Boolean @default(false)
  /// This action's own default stance on requiring human approval,
  /// independent of anything `PolicyEngine`/`RiskEngine` decide --
  /// carried in the schema for a future phase's policy-authoring
  /// ergonomics (e.g. "pre-fill a new policy rule's effect from this");
  /// not read by `RiskEngine`/`AuthorizationService` this phase (Phase
  /// 6's `APPROVAL_REQUIRED` routing already comes from the policy/risk
  /// pipeline, which stays the single source of truth for that decision
  /// -- see docs/policy-model.md).
  approvalDefault Boolean @default(false)

  createdAt DateTime @default(now())

  invocations ToolInvocation[]

  @@unique([toolId, name])
  @@map("tool_actions")
}

/// Operational record of one attempted tool call (Section 35) --
/// deliberately *not* the tamper-evident audit hash chain (that's Phase
/// 9's scope, see `docs/tool-gateway.md`): just enough to show a call
/// happened, what it targeted, and whether it succeeded, for operational
/// visibility and debugging. Never stores the resolved credential, the
/// raw request body, or the raw response body (any of which might carry
/// secret material) -- `resource`/`status`/timestamps/`errorMessage` are
/// shape/summary only, by construction (`CredentialBrokerService` never
/// has a code path that writes anything else into this table -- see that
/// service's own doc comment and the "credential never leaks" test).
model ToolInvocation {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id])

  actionId String
  action   ToolAction @relation(fields: [actionId], references: [id])

  /// The resource string the invocation targeted (the same `resource`
  /// value passed to `AuthorizationService.authorize`) -- an identifier,
  /// never a full request/response payload.
  resource String

  status ToolInvocationStatus

  startedAt   DateTime
  completedAt DateTime?
  /// Set only on `FAILURE` -- the adapter/broker's own error message
  /// (e.g. "HTTP 503", "tool disabled"), never a raw response body that
  /// might carry secret material.
  errorMessage String?

  /// ADR-003: the `Decision` this execution ran under. The decision commits
  /// before the tool is contacted; this row records the outcome
  /// (`SUCCESS`/`FAILURE`/`UNKNOWN`) against it. Null only for rows written
  /// before the column existed.
  decisionId String?
  decision   Decision? @relation(fields: [decisionId], references: [id])

  createdAt DateTime @default(now())

  @@index([decisionId])
  @@map("tool_invocations")
}

/// `Decision.outcome` -- the spec's three-valued decision.
enum DecisionOutcome {
  ALLOW
  APPROVAL_REQUIRED
  DENY
}

/// Which door the action request came through. `AUTHORIZE` is
/// `POST /agent/v1/authorize`, which decides without executing.
enum DecisionChannel {
  REST
  MCP
  AUTHORIZE
}

/// `REQUEST`: an agent's first attempt. `GRANT_REDEMPTION`: the retry with an
/// approval grant, re-decided against current state (S6/F7).
enum DecisionStage {
  REQUEST
  GRANT_REDEMPTION
}

/// ADR-003 / security finding S1: the durable record of one authorization
/// decision, committed in PostgreSQL before anything executes. For ALLOW it
/// commits in the same transaction as the execution-count increment (first
/// attempt) or the grant consumption (redemption). If it cannot be written
/// the request fails closed with 503 and nothing executes.
///
/// Append-only. No foreign keys to `Task`/`Agent`: a DENY for an unknown
/// task is still a decision, and decisions outlive what they name. The
/// execution outcome links back through `ToolInvocation.decisionId`.
model Decision {
  id String @id @default(uuid())

  outcome DecisionOutcome
  /// The decisive reason first (`allowed`, `policy_denied`,
  /// `risk_ceiling_exceeded`, ...), then any deterministic risk reason codes.
  reasonCodes String[]

  /// The policy whose rule matched, when one did.
  policyId        String?
  policyVersionId String?
  /// Deterministic `RiskEngine` score, when the pipeline got that far.
  riskScore       Int?

  /// sha256 of the canonical `{ taskId, toolId, actionId, resource, params }`
  /// (`computeParameterHash`, the same hash an approval grant binds to).
  inputsHash String

  agentId  String
  taskId   String
  toolId   String
  actionId String
  resource String

  channel DecisionChannel
  stage   DecisionStage   @default(REQUEST)
  /// The `AuthorizationGrant` presented, for `GRANT_REDEMPTION`.
  grantId String?

  correlationId String

  createdAt DateTime @default(now())

  toolInvocations ToolInvocation[]

  @@index([taskId, createdAt])
  @@index([agentId, createdAt])
  @@index([grantId])
  @@map("decisions")
}

/// `ToolInvocation.status` -- Section 35 explicitly asks for exactly these
/// two outcomes (an operational record, not a state machine).
enum ToolInvocationStatus {
  SUCCESS
  FAILURE
  /// A mutating or destructive call ended without a definite answer; the
  /// side effect may have happened and needs reconciliation (Gate 0 R1).
  UNKNOWN
}

/// `ApprovalRequest.status` (Phase 8, Sections 27/28/31). A new request is
/// always `PENDING` -- the only state `ApprovalWorkflow` itself creates it
/// in, before that workflow ever runs. `APPROVED`/`DENIED` are set by the
/// workflow's own re-evaluation Activity once a human `decide`s (`DENIED`
/// also covers the case where re-evaluation itself fails the approved
/// decision -- see docs/approvals.md's "why DENIED, not a third failure
/// state" note). `EXPIRED` is set by the workflow's own timeout Activity
/// when nobody decides before `expiresAt` -- never by anything polling or
/// reading this row.
enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

/// `ApprovalDecision.decision` -- a human's raw input to `ApprovalWorkflow`
/// (via its `decide` signal), recorded verbatim before any re-evaluation
/// happens. Note this is distinct from `ApprovalRequest.status`: an
/// `APPROVE` decision can still produce a `DENIED` request status if
/// re-evaluation at approval time no longer supports it (Section 27 -- see
/// `ApprovalStatus`'s doc comment).
enum ApprovalDecisionType {
  APPROVE
  DENY
}

/// A pending (or resolved) human-approval gate for one specific
/// `APPROVAL_REQUIRED` decision from `AuthorizationService`'s pipeline
/// (Phase 8, Sections 27/28/31 -- see docs/approvals.md). Created by `POST
/// /agent/v1/tools/invoke` the moment that pipeline yields
/// `APPROVAL_REQUIRED`, in the same call that starts the `ApprovalWorkflow`
/// this row's `temporalWorkflowId` names -- no tool call is ever attempted
/// at this point (Section 80's "pending action cannot execute before
/// approval" invariant).
///
/// `toolId`/`actionId`/`resource`/`params` are the *exact* values from the
/// original `POST /agent/v1/tools/invoke` request that triggered this
/// approval -- never re-derived or re-typed later. `params` in particular
/// is what `AuthorizationGrant.parameterHash` (once issued) binds to: the
/// agent's eventual retried request must match these exact values byte for
/// byte (after canonicalization -- see `src/approvals/parameter-hash.util.ts`)
/// or its grant is rejected (Section 80's parameter-binding invariant).
///
/// `policyVersionId` is nullable: a `APPROVAL_REQUIRED` decision can come
/// from a matched policy rule (`policyVersionId` set, to the version whose
/// rule matched) *or* purely from `RiskEngine`'s score exceeding
/// `task.riskCeiling` with no policy rule having matched at all -- see
/// `AuthorizationService`'s `risk_ceiling_exceeded` reason, which leaves no
/// version to record.
model ApprovalRequest {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  toolId   String
  actionId String
  resource String
  /// The exact `params` submitted to `POST /agent/v1/tools/invoke` -- see
  /// model doc comment for why this must never be re-derived.
  params Json

  /// The `RiskEngine.finalRiskScore` (0-100) that was part of why this
  /// request required approval -- carried here (rather than only in
  /// structured logs) so a human decision-maker and the eventual
  /// `AuthorizationGrant` can both see exactly what was being approved.
  riskScore Int

  /// Release 2026-11-11 (brief §3.4) — the *breakdown* behind `riskScore`,
  /// captured at request time.
  ///
  /// `riskScore` alone told an approver a number and nothing about where
  /// it came from. These four fields exist because the brief requires the
  /// reviewer to receive the risk factors and the policy version behind
  /// the request, with deterministic factors and AI signals **separately
  /// attributed** — a blended score is exactly what an approver cannot
  /// reason about.
  ///
  /// All four are nullable/defaulted rather than required, because rows
  /// written before this migration genuinely do not have them. A reader
  /// must render those as *not recorded*, never as zero and never as an
  /// absence of AI involvement — "we did not capture this" and "there was
  /// no AI signal" are different facts, and `aiAdvisoryScore` is itself
  /// legitimately null whenever no advisory signal was available.
  ///
  /// `RiskEngine` already computes all of this
  /// (`RiskScoreResult.deterministicRiskScore`/`aiAdvisoryScore`/
  /// `reasonCodes`); until now it reached only the structured log and the
  /// `authorization.pending_approval` audit event, neither of which the
  /// approvals UI can join to a request.
  deterministicRiskScore Int?
  /// `null` means no advisory signal was available (manar-ai unreachable,
  /// timed out, circuit open, or a zero-confidence fail-secure marker) --
  /// see `AiAdvisoryClient`. It never means "the AI said zero".
  aiAdvisoryScore        Int?
  /// Phase 1 (ADR-004): whether NO AI advisory is attached to this approval.
  /// Defaults to `true` — absent until proven present — because the advisory
  /// is no longer a decision input and is fetched off the decision path by
  /// `ApprovalWorkflow` after the approval row already exists.
  ///
  /// This exists so the console can tell an approver "the AI said low risk"
  /// apart from "the AI never answered". A null `aiAdvisoryScore` alone cannot
  /// carry that distinction, and CLAUDE.md §6 requires manar-ai being
  /// unavailable to be visible on the record rather than silently absent.
  advisoryUnavailable    Boolean @default(true)
  /// `RiskScoreResult.reasonCodes` verbatim, in the order applied.
  /// AI-derived codes carry the `ai_advisory_*` prefix, so a consumer can
  /// separate attribution without a second field -- see that type's own
  /// doc comment for why they are never blended into one anonymous list.
  riskReasonCodes        Json  @default("[]")
  /// The `Task.riskCeiling` in force when this request was raised -- what
  /// `riskScore` was actually compared against. Without it, a reader
  /// cannot tell whether 62 was over or under the line.
  taskRiskCeiling        Int?

  /// Why approval was required: `"policy_requires_approval"` (a published
  /// policy rule's effect) or `"risk_ceiling_exceeded"` (the score alone).
  ///
  /// Persisted rather than derived. Deriving it from `policyVersionId`
  /// being null looks correct and is not: a matched *ALLOW* rule also
  /// records its `policyVersionId`, so a request that reached approval
  /// purely on the risk ceiling can still carry one. `AuthorizationService`
  /// already computes this exact string; it simply never reached the row.
  ///
  /// Null on rows written before this migration -- render as "not
  /// recorded", never as either value.
  requiredReason         String?

  /// The published `PolicyVersion` whose rule produced this
  /// `APPROVAL_REQUIRED` decision -- null when the decision came purely
  /// from `RiskEngine`'s score exceeding `task.riskCeiling` with no policy
  /// rule matching at all. See model doc comment.
  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])

  status ApprovalStatus @default(PENDING)

  requestedAt DateTime @default(now())
  /// This request's own timeout -- `ApprovalWorkflow`'s `decide` signal
  /// wait races against this exact instant (Temporal `sleep`, not a cron
  /// job polling this column). Nobody deciding before this passes ->
  /// `status = EXPIRED`, and no `AuthorizationGrant` is ever issuable for
  /// this request again (see `APPROVAL_REQUEST_TTL_MS`,
  /// `src/approvals/approvals.config.ts` -- 30 minutes by default).
  expiresAt DateTime

  /// The `ApprovalWorkflow` run this request is bound to 1:1 -- what
  /// `POST /approvals/:id/decide` signals and what this row's own
  /// `status`/`AuthorizationGrant` are ultimately written by (from inside
  /// that workflow's own Activities, never directly by the decide/poll
  /// HTTP handlers themselves).
  temporalWorkflowId String @unique

  /// 1:many even though this phase only ever produces one row per request
  /// (decision #33: one approver) -- this is what lets a future N-of-M
  /// approval chain be added without a schema migration; N-of-M logic
  /// itself is out of scope this phase (see docs/approvals.md).
  decisions ApprovalDecision[]

  /// Set only when this request's outcome was `APPROVED` and
  /// re-evaluation at approval time still supported it -- 1:1 (a request
  /// produces at most one grant, ever; see `AuthorizationGrant`'s own doc
  /// comment for why a *replay* of an already-consumed grant is rejected
  /// rather than a new one being issued).
  grant AuthorizationGrant?

  createdAt DateTime @default(now())

  @@map("approval_requests")
}

/// One human's raw decision on an `ApprovalRequest` (Phase 8, decision #33:
/// exactly one approver decides, this phase) -- written by
/// `ApprovalWorkflow`'s own re-evaluation Activity after processing the
/// `decide` signal `POST /approvals/:id/decide` sends, never written
/// directly by that HTTP handler itself (workflow code has no I/O of its
/// own -- Section 28 -- but the *Activity* it invokes does the actual
/// write, and is the only thing that ever does). Modeled 1:many against
/// `ApprovalRequest` (see that model's own doc comment) even though this
/// phase only ever produces one row per request.
model ApprovalDecision {
  id String @id @default(uuid())

  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id])

  approverId String
  approver   UserProfile @relation(fields: [approverId], references: [id])

  decision ApprovalDecisionType
  reason   String?

  decidedAt DateTime @default(now())

  @@map("approval_decisions")
}

/// A short-lived, signed, single-use, exactly parameter-bound grant of
/// authority to execute one specific pending tool action (Phase 8, Section
/// 31 -- see docs/approvals.md for the full grant-token format and how
/// `id` doubles as its `jti`). Issued by `ApprovalWorkflow`'s
/// re-evaluation Activity, and only when: the originating
/// `ApprovalRequest`'s task is still `ACTIVE`/unexpired/under its
/// execution limit, its agent is still `ACTIVE`, and a fresh
/// `PolicyEngine`/`RiskEngine` evaluation (re-run at *this* moment, never
/// trusting the original, possibly-stale decision -- Section 27) still
/// does not deny the action outright. At most one `AuthorizationGrant` is
/// ever created per `ApprovalRequest` (`approvalRequestId` is `@unique`) --
/// there is no "issue another grant for the same request" path anywhere in
/// this codebase; a consumed, expired, or otherwise-invalid grant is
/// simply rejected on retry (Section 80's approval-replay invariant),
/// never silently re-issued.
///
/// `parameterHash` binds this grant to the *exact* `taskId`/`toolId`/
/// `actionId`/`resource`/`params` of the originating `ApprovalRequest` --
/// `POST /agent/v1/tools/invoke`'s retried request (with `grantToken` set)
/// must recompute an identical hash from its own body or the grant is
/// rejected, even if every other field matches (Section 80's
/// parameter-binding invariant -- see
/// `src/approvals/parameter-hash.util.ts`).
///
/// `consumedAt` enforces single-use: `POST /agent/v1/tools/invoke` sets it
/// via a conditional `UPDATE ... WHERE consumedAt IS NULL` (the same
/// race-closing pattern `AuthorizationService.incrementExecutionCount`
/// already uses for `Task.executionCount`) the moment a valid grant is
/// actually used to reach `CredentialBrokerService.invoke` -- a second use
/// of the same token, concurrent or sequential, always loses that race and
/// is denied. `revokedAt` is unused this phase (kill-switch-driven grant
/// revocation is a dedicated later phase) -- the column exists now purely
/// so that phase needs no migration.
model AuthorizationGrant {
  id String @id @default(uuid())

  approvalRequestId String          @unique
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id])

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  toolId   String
  actionId String
  resource String

  /// sha256 hex of the canonicalized `{ taskId, toolId, actionId, resource,
  /// params }` this grant was issued for -- see model doc comment.
  parameterHash String

  /// The `PolicyVersion` re-evaluation confirmed was still published at
  /// grant-issuance time -- null under the same condition
  /// `ApprovalRequest.policyVersionId` is (see that field's doc comment).
  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])

  /// `RiskEngine.finalRiskScore` as of *re-evaluation* (grant-issuance
  /// time), not necessarily equal to `ApprovalRequest.riskScore` (the
  /// original, possibly-stale score) -- Section 27's "don't assume an
  /// action remains safe because approval happened N minutes ago" made
  /// concrete: this is the score that actually justified issuing this
  /// grant.
  riskScore Int

  issuedAt DateTime @default(now())
  /// Short -- `APPROVAL_GRANT_TTL_MS` (`src/approvals/approvals.config.ts`,
  /// 5 minutes by default): an agent that doesn't retry
  /// `POST /agent/v1/tools/invoke` with this grant soon after `APPROVED`
  /// becomes visible via `GET /agent/v1/approvals/:id` finds it expired
  /// and must go through approval again from scratch (no grant-renewal
  /// path exists).
  expiresAt DateTime

  /// Set the moment this grant is actually used to reach
  /// `CredentialBrokerService.invoke` -- see model doc comment. Null means
  /// unconsumed (still usable, if unexpired).
  consumedAt DateTime?
  /// Unused this phase -- see model doc comment.
  revokedAt DateTime?

  @@map("authorization_grants")
}

/// Phase 9a (Tamper-Evident Audit Chain & Kafka Event Backbone). One
/// append-only, hash-chained record of a single security-relevant decision or
/// action anywhere in the product (Section 46 — enough `data` to
/// reconstruct *why* a decision occurred, not just its outcome). **Append-
/// only**: there is no update/delete endpoint or code path for this model
/// anywhere in the application (retention deletion is Phase 9b's scope, via
/// its own dedicated, auditable workflow — never ad hoc code). Every write
/// goes exclusively through `AuditService.record` (`src/audit/audit.service.ts`),
/// which computes `eventHash` from the canonicalized event content plus the
/// event's partition's current `previousHash` (see `src/audit/canonical-json.ts`)
/// inside the same transaction that advances that `AuditPartitionState` row —
/// see that model's doc comment for how a fork is prevented across concurrent
/// callers/replicas. Each tenant's log is 64 chains (`src/audit/audit-partition.ts`).
///
/// `sequence` is a plain autoincrement purely for cheap, reliable "walk the
/// chain in the order it was actually written" ordering (`verifyAuditChain`
/// / a future export) — it plays no role in the hash chain itself, which is
/// entirely defined by `previousHash`/`eventHash` linkage and would still be
/// verifiable without it; `createdAt` alone is not a safe substitute since
/// two events recorded within the same millisecond would tie.
model AuditEvent {
  id String @id @default(uuid())

  /// Ordering only — see model doc comment. Never referenced by the hash
  /// computation itself.
  sequence Int @default(autoincrement())

  /// Section 29's event-type catalog (`agent.enrolled`, `task.created`,
  /// `authorization.denied`, ...) — see `src/audit/audit-event-types.ts`.
  eventType String

  /// Groups every event produced by one end-to-end request/workflow run —
  /// reuses the request's `x-correlation-id` (`src/logging/correlation-id.store.ts`)
  /// when one is available (every HTTP-originated event), or a
  /// service-generated UUID for events recorded outside any HTTP request
  /// context (e.g. the separate Temporal worker process, which never
  /// imports `LoggingModule` — see `src/audit/audit.service.ts`).
  correlationId String

  /// `{ type: 'human' | 'agent' | 'system', id: string }` — never a bare
  /// string, so a consumer never has to guess which kind of principal
  /// caused this event. `id` is a `UserProfile.id`, `Agent.id`, or a fixed
  /// system label (e.g. `"system:policy-engine"`), depending on `type`.
  actor Json

  /// When this event was recorded — captured once, in application code,
  /// *before* the hash is computed (never `DateTime.now()`/a DB default,
  /// which would make the hash unreproducible from the row's own stored
  /// fields). Distinct from `createdAt` (the row's insert time) purely as a
  /// hygiene matter; the two are set from the same `Date` in practice.
  timestamp DateTime

  /// The actual decision inputs (Section 46) — e.g. matched policy id/
  /// version, risk score, OpenFGA result, denial reason — never just
  /// "denied". **Never the resolved credential value** for a tool
  /// invocation event (a hard rule — see `src/audit/audit-event-types.ts`
  /// and `test/audit-credential-secrecy.e2e-spec.ts`, which greps the
  /// actual stored row).
  data Json

  /// The previous `AuditEvent.eventHash` **in the same partition** at the
  /// moment this event was appended — `null` only for the first event of a
  /// partition. Forms the hash chain together with `eventHash` below; see
  /// `src/audit/canonical-json.ts` and `AuditService.verifyAuditChain`.
  previousHash String?

  /// `sha256(canonicalize({ id, eventType, correlationId, actor, timestamp,
  /// data, previousHash }))` — see `src/audit/canonical-json.ts` for why
  /// this uses an explicit recursive-key-sort canonicalization rather than
  /// relying on `JSON.stringify`'s key-insertion-order behavior (a
  /// dependency a future refactor of how this object is constructed could
  /// silently break without ever touching this file).
  eventHash String

  /// Which of the tenant's 64 hash chains this event is in
  /// (`partitionFor` in `src/audit/audit-partition.ts`). Events from before
  /// partitioning are all partition 0, in their original order.
  partition Int @default(0)

  /// 1-based position within `partition`. Dense and strictly increasing per
  /// partition, so a checkpoint (`AuditCheckpoint.roots`) can name a range.
  partitionSeq Int

  createdAt DateTime @default(now())

  @@unique([partition, partitionSeq])
  @@index([eventType])
  @@index([correlationId])
  /// Release 2026-11-11: `AuditService.verifyAuditChain` walks the chain in
  /// keyset-paginated batches (`WHERE sequence > ?` ordered by `sequence`)
  /// so a large tenant can no longer OOM the pod. Without this index every
  /// batch still costs a sort of the whole table — bounded memory but not
  /// bounded work. Retention pruning scans the same column.
  @@index([sequence])
  @@map("audit_events")
}

/// One bookkeeping row per audit partition (0–63), so appending the next
/// `AuditEvent` never scans the table for its partition's tail. Replaces the
/// single `AuditChainState` row, whose `SELECT ... FOR UPDATE` serialised
/// every audit write in the tenant.
///
/// `AuditService` writes in batches (group commit): one transaction locks the
/// rows of exactly the partitions the batch touches, **in ascending partition
/// order** (so two replicas flushing overlapping batches can never deadlock),
/// appends the batch's events and advances these rows. A real Postgres row
/// lock, so concurrent replicas still cannot fork a partition's chain.
model AuditPartitionState {
  partition Int @id

  latestEventId   String?
  latestEventHash String?

  /// `partitionSeq` of the latest event (0 before the first).
  latestSeq Int @default(0)

  eventCount Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("audit_partition_state")
}

/// A SEAL: the signed, per-second summary of everything appended since the
/// previous one (`src/audit/checkpoint/`). For each partition that advanced,
/// `roots` holds the RFC 6962 Merkle root of the events in
/// `(previous head, new head]`; `partitionHeads` holds every partition's tail.
/// Checkpoints form their own chain through `previousCheckpointHash`, and
/// each is Ed25519-signed with the tenant's own key (OpenBao KV). An event's
/// inclusion proof is ~log2(n) hashes up to one of these roots.
model AuditCheckpoint {
  seq BigInt @id

  createdAt DateTime

  /// `{ partition, seq, eventHash }[]` for every partition with events.
  partitionHeads Json

  /// `{ partition, fromSeq, toSeq, root }[]`, only partitions that advanced.
  roots Json

  previousCheckpointHash String?

  /// `sha256(canonicalize({ seq, createdAt, partitionHeads, roots, previousCheckpointHash }))`.
  checkpointHash String @unique

  /// Base64 Ed25519 signature over the 32 bytes of `checkpointHash`.
  signature String

  /// First 16 hex chars of SHA-256 over the signing key's SPKI DER.
  keyId String

  @@map("audit_checkpoints")
}

/// One row per range a SEAL covers (a copy of its `roots`), indexed so an
/// event's covering SEAL is found without scanning every SEAL's JSON.
/// Written in the same transaction as the SEAL; the SEAL's signed `roots`
/// stay authoritative.
model AuditCheckpointRange {
  partition     Int
  fromSeq       Int
  toSeq         Int
  checkpointSeq BigInt
  root          String

  @@id([partition, fromSeq])
  @@index([partition, toSeq])
  @@map("audit_checkpoint_ranges")
}

/// Phase 9b (Retention, Section 48). Written exclusively by
/// `AuditRetentionWorkflow`'s Activity (`src/audit/retention/`), immediately
/// before it deletes the aged-out `AuditEvent` rows a given retention run
/// prunes — never by any HTTP/CLI path (there is no update/delete endpoint
/// for this model either; it is itself append-only). `anchorHash` is the
/// last-to-be-pruned event's own `eventHash` (by `sequence` — i.e. the most
/// recent among those being deleted, the one immediately preceding the
/// oldest *surviving* event in the chain) — this is what lets
/// `verifyAuditChain` (Phase 9a, `src/audit/audit.service.ts`) keep working
/// after old events are gone: chain verification now accepts the oldest
/// *remaining* event's `previousHash` as valid if it matches either `null`
/// (true genesis — no retention has ever run) or a known
/// `AuditChainAnchor.anchorHash` for this tenant, instead of requiring that
/// ancestor row to still exist.
///
/// `tenantId` is carried explicitly even though this is already a
/// per-tenant-isolated database (Phase 2 — see docs/tenant-isolation.md,
/// same structural scoping `AuditEvent`/`AuditPartitionState` get for free) —
/// kept for the same defense-in-depth/self-describing-row reason a handful
/// of other models in this schema (e.g. `RoleBinding.grantedBy`) carry
/// free-text provenance beyond what a foreign key alone would establish.
model AuditChainAnchor {
  id String @id @default(uuid())

  tenantId String

  /// The pruned segment's last `AuditEvent.eventHash` — see model doc
  /// comment. Not a foreign key (the `AuditEvent` row it names has, by
  /// definition, just been deleted in the same retention run).
  anchorHash String

  anchoredAt DateTime @default(now())

  /// How many `AuditEvent` rows this retention run deleted — carried here
  /// (rather than only in the paired `audit.retention_executed`
  /// `AuditEvent`'s own `data`) so an operator can inspect retention
  /// history without walking the audit chain itself.
  eventsPrunedCount Int

  /// The audit partition this anchor continues (retention prunes each
  /// partition's head separately). Required: an anchor must never silently
  /// land in partition 0. Anchors from before partitioning were set to 0.
  partition Int

  /// Base64 Ed25519 signature by the tenant's checkpoint key over
  /// `anchorDigestOf` (`src/audit/checkpoint/checkpoint-format.ts`), written
  /// by retention. Verification only accepts signed anchors; `null` only on
  /// anchors from before partitioning (partition 0).
  signature String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("audit_chain_anchors")
}

/// Phase 10b (AI Advisory Pipeline Integration): a short-lived,
/// time-boxed elevated-risk flag for one agent, set by
/// `CredentialBrokerService` when `AiAdvisoryClient.analyzePromptInjection`
/// detects a prompt-injection attempt in a tool's returned result (see
/// docs/ai-security-model.md). Deliberately minimal — `agentId`/`reason`/
/// `expiresAt` only, NOT the full `BehaviorBaseline`/`BehaviorObservation`
/// modeling system (a larger, later concern, out of scope this phase) — a
/// row here means nothing more than "treat this agent's *subsequent*
/// requests as somewhat riskier for a while," never a decision of its own:
/// `RiskEngine.score` looks up whether an active (unexpired) row exists for
/// the requesting agent via a plain DB query (never another AI call) and
/// folds a small, fixed, documented bump into `deterministicRiskScore` when
/// one does — see that class's own doc comment for the exact point value.
/// The injected content itself is never trusted or executed by anything in
/// this codebase regardless of this flag (Section 72 — the actual security
/// boundary stays deterministic task scope; this is a secondary,
/// defense-in-depth signal only).
///
/// Rows are never updated — a new detection always inserts a new row,
/// never extends an existing one's `expiresAt` — and are never deleted by
/// application code (an expired row is simply ignored by the `expiresAt`
/// filter every reader uses; retention/cleanup of old rows, like
/// `AuditEvent`'s, is out of scope this phase).
model AgentRiskFlag {
  id String @id @default(uuid())

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  /// Short, machine-readable summary of what triggered this flag (e.g.
  /// `prompt_injection_detected:<toolId>/<actionId>`) — human/audit
  /// readability only, never parsed by `RiskEngine`.
  reason String

  createdAt DateTime @default(now())
  /// This flag stops contributing to `RiskEngine.score` once passed — see
  /// model doc comment for the lookup semantics.
  expiresAt DateTime

  @@index([agentId, expiresAt])
  @@map("agent_risk_flags")
}

/// Kill-switch phase (Section 32): the four tenant-scoped kill-switch
/// levels — TENANT (the entire tenant), AGENT_GROUP, AGENT, TOOL. The
/// fifth, cross-tenant PLATFORM scope is deliberately NOT here — see
/// `PlatformKillSwitch` in `prisma/control.prisma` for why. See
/// docs/kill-switches.md.
enum KillSwitchScope {
  TENANT
  AGENT_GROUP
  AGENT
  TOOL
}

/// One kill switch, checked directly on the hot authorization path
/// (`AuthorizationService.authorize`) and re-checked at
/// `AuthorizationGrant` redemption time (`GrantService.validateAndConsumeGrant`)
/// — Section 32's harder requirement that an already-issued grant must
/// become unusable the moment a relevant kill switch activates, not just
/// block new authorization requests. See docs/kill-switches.md.
///
/// One row per (scope, targetId) pair, toggled in place by activate/
/// deactivate rather than appended as history (both the activation and
/// deactivation fields live on the same row) — a plain DB check on every
/// request already has zero propagation delay by construction, so there is
/// no need for a separate propagation/event mechanism on top (out of scope
/// this phase — see docs/kill-switches.md).
///
/// `targetId` is `null` only for `TENANT` scope — the tenant itself is
/// implicit via the tenant database (Phase 2's per-tenant isolation model,
/// see docs/tenant-isolation.md), so there is nothing else to name. For
/// `AGENT_GROUP`/`AGENT`/`TOOL` it is that row's own id (`AgentGroup.id`/
/// `Agent.id`/`Tool.id`) — not a foreign key, since a `TOOL`-scope switch
/// must still deny even if the `Tool` row is later deleted, and because a
/// single column can't be a conditional FK across three different target
/// tables depending on `scope`.
model KillSwitch {
  id String @id @default(uuid())

  scope    KillSwitchScope
  targetId String?

  active Boolean @default(true)
  reason String?

  activatedBy String
  activator   UserProfile @relation("KillSwitchActivations", fields: [activatedBy], references: [id])
  activatedAt DateTime    @default(now())

  deactivatedBy String?
  deactivator   UserProfile? @relation("KillSwitchDeactivations", fields: [deactivatedBy], references: [id])
  deactivatedAt DateTime?

  createdAt DateTime @default(now())

  /// The hot-path lookup this model exists for: "is there an active switch
  /// for this exact scope+target right now."
  @@index([scope, targetId, active])
  @@map("kill_switches")
}

/// ADR-0009 (watcher). A quarantined agent's every action is DENY
/// `agent_quarantined`, at authorize, at grant redemption and at the
/// agent-runtime gate (`KillSwitchService.checkAll`). Its mTLS identity keeps
/// working so it can read the reason.
///
/// One row per agent, toggled in place like `KillSwitch` (history lives in
/// the audit chain: `agent.quarantined` / `agent.quarantine_released`). An
/// agent (the watcher, through `manar.agent.quarantine`) can only set
/// `active = true`; only a human (`POST /agents/:id/quarantine/release`,
/// JWT + role) sets it back to false.
model AgentQuarantine {
  id      String @id @default(uuid())
  agentId String @unique
  agent   Agent  @relation(fields: [agentId], references: [id])

  active    Boolean
  /// Short deterministic reason written by the detector that fired.
  reason    String
  detector  String?
  /// Evidence references (decision ids, audit event ids). Ids only.
  evidence  Json    @default("[]")
  /// Plain-English and Arabic explanation written by the watcher's model
  /// after the quarantine landed; set at most once per quarantine. Generated
  /// text, labelled as such wherever it is shown.
  explanationEn String?
  explanationAr String?

  /// The agent that quarantined (the watcher), and the ALLOW `Decision` it ran under.
  quarantinedByAgentId String
  decisionId           String?
  quarantinedAt        DateTime

  /// The human (`UserProfile.id`) who released it.
  releasedBy  String?
  releasedAt  DateTime?
  releaseNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_quarantines")
}

/// Phase 12a (Webhooks, Section 51). One registered subscriber URL per row
/// — an admin-managed configuration object, not itself part of the audit
/// hash chain (Phase 9a's `AuditEvent` remains the tamper-evident record;
/// this is a delivery *subscription*). See docs/security.md's webhook
/// section for the HMAC signing scheme every delivery uses.
model WebhookEndpoint {
  id String @id @default(uuid())

  /// The receiver URL. Validated by the shared SSRF guard
  /// (`assertSafeOutboundUrl`, `src/common/ssrf/url-safety.ts`) both at
  /// registration time (`WebhookRegistryService.create`) AND re-validated
  /// at delivery time (`WebhookDeliveryService`) — the same
  /// registration-time-is-not-enough posture `HttpToolAdapter`/
  /// `McpToolAdapter` now also apply to `Tool.baseEndpoint`.
  url String

  /// A `SecretReferenceDescriptor` (`{ provider, reference }` — the exact
  /// same shape `Tool.credentialReference` already uses, see
  /// `src/database/secret-provider.ts`) naming where this endpoint's HMAC
  /// signing secret actually lives — never plaintext in this column.
  /// `WebhookRegistryService.create` generates a random secret and writes
  /// it via `OpenBaoKvClient.writeSecret` itself (there's no external
  /// system to pre-provision this the way a `Tool`'s credential is —
  /// registering a webhook is what *creates* the secret in the first
  /// place), then stores only this pointer.
  secretReference Json

  /// Values from Phase 9a's real event-type catalog
  /// (`AUDIT_EVENT_TYPES`, `src/audit/audit-event-types.ts`) — this
  /// endpoint's `WebhookDeliveryConsumerService` only ever POSTs an event
  /// whose `eventType` is present here.
  subscribedEventTypes String[]

  enabled Boolean @default(true)

  createdBy String
  creator   UserProfile @relation("WebhookEndpointCreations", fields: [createdBy], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

/// One row per (endpoint, event) delivery attempt history —
/// `WebhookDeliveryConsumerService` creates it (status `PENDING`) the
/// moment a subscribed event is consumed off Kafka, then
/// `WebhookDeliveryWorkflow`'s Activities update it in place as attempts
/// happen, ending in `SUCCESS` or (once Temporal's own retry policy is
/// exhausted) `FAILED`. `@@unique([webhookEndpointId, eventId])` is this
/// model's own idempotency: Kafka's at-least-once delivery redelivering the
/// same event must never create a second delivery row/second Temporal
/// workflow for it (mirrors `AuditIndexerService`'s "upsert by eventId,
/// never blindly append" contract for the same underlying reason).
model WebhookDelivery {
  id String @id @default(uuid())

  webhookEndpointId String
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id])

  /// The `AuditEvent.id` (== the Kafka envelope's `eventId`) being
  /// delivered.
  eventId   String
  eventType String

  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  /// The receiver's last HTTP response status code, or `null` before the
  /// first attempt or when an attempt never reached the receiver at all
  /// (DNS/connection/timeout failure).
  responseStatus Int?

  createdAt DateTime @default(now())

  @@unique([webhookEndpointId, eventId])
  @@index([webhookEndpointId])
  @@map("webhook_deliveries")
}

/// Phase 15a (Section 55) -- an honest, non-exhaustive compliance-control
/// mapping subsystem: real, researched controls from ISO/IEC 27001:2022
/// Annex A and NIST AI RMF 1.0 (NIST.AI.100-1), each backed by an
/// evidence-grounded `ComplianceMapping` row describing what this codebase
/// has *actually* built and tested, citing the relevant `docs/*.md` file --
/// never a claim of certification (see docs/compliance-mapping.md). Rows
/// are seeded directly by this model's own migration
/// (`prisma/tenant/migrations/20260819210000_add_compliance_mapping/migration.sql`)
/// rather than an app-level seed command: this is reference content
/// describing the *product's* own capabilities, identical for every
/// tenant, not tenant-specific configuration -- every tenant (including
/// ones provisioned in the future) gets it automatically via
/// `TenantDatabaseManager.provisionTenant`'s `prisma migrate deploy`, the
/// same mechanism that already applies every other migration.
model ComplianceFramework {
  id      String @id @default(uuid())
  name    String @unique
  version String

  controls ComplianceControl[]

  @@map("compliance_frameworks")
}

/// One control from a `ComplianceFramework`, in that framework's own
/// numbering (`controlId`, e.g. `"A.5.15"` or `"GOVERN 6.1"` -- never
/// Manar's own invented numbering).
model ComplianceControl {
  id          String              @id @default(uuid())
  frameworkId String
  framework   ComplianceFramework @relation(fields: [frameworkId], references: [id])

  /// The framework's own control identifier, e.g. `"A.5.15"` (ISO 27001)
  /// or `"GOVERN 6.1"` (NIST AI RMF) -- unique within one framework, not
  /// globally.
  controlId   String
  title       String
  description String

  mapping ComplianceMapping?

  @@unique([frameworkId, controlId])
  @@map("compliance_controls")
}

/// Section 55's four allowed self-assessment statuses -- deliberately not
/// a pass/fail boolean, and never a fifth "certified" value (this
/// subsystem tracks mapping/evidence, never certification -- see
/// docs/compliance-mapping.md).
enum ComplianceMappingStatus {
  MAPPED
  EVIDENCE_AVAILABLE
  PARTIALLY_IMPLEMENTED
  NOT_EVALUATED
}

/// This codebase's own honest self-assessment against one
/// `ComplianceControl` -- one mapping per control (`@@unique` below), not a
/// history; re-running this phase's research and updating the assessment
/// means editing the seed data via a new migration, not a versioned model
/// (out of scope this phase -- see docs/compliance-mapping.md).
model ComplianceMapping {
  id String @id @default(uuid())

  controlId String            @unique
  control   ComplianceControl @relation(fields: [controlId], references: [id])

  status ComplianceMappingStatus @default(NOT_EVALUATED)

  /// Free text pointing at real, specific capabilities -- e.g. "Task-scoped
  /// OpenFGA authorization with deterministic subset-checked delegation,
  /// see docs/authorization-model.md and docs/task-delegation.md." Never
  /// fabricated, never a generic restatement of the control's own title.
  evidenceDescription String

  /// Nullable link/path to more detail (a docs/*.md file, a test file) --
  /// `evidenceDescription` alone is sometimes sufficient and doesn't
  /// require a second, more specific pointer.
  evidenceReference String?

  assessedAt DateTime

  @@map("compliance_mappings")
}

/// Phase 15a (Section 70) -- a first-class security incident, linked to
/// existing audit data via `relatedCorrelationIds` rather than a new
/// relation table: Phase 9a's `AuditEvent.correlationId` (and, downstream,
/// `GET /audit`'s OpenSearch-backed search and `POST /evidence/export`'s
/// signed bundle export) is already the connective tissue this product
/// uses to tie a set of related events together -- an `Incident` simply
/// names a *curated* subset of correlation IDs a human investigator has
/// determined are related to one security event, not a fresh audit
/// mechanism of its own.
enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model Incident {
  id          String @id @default(uuid())
  title       String
  description String

  severity IncidentSeverity
  status   IncidentStatus   @default(OPEN)

  /// Json array of `AuditEvent.correlationId` strings this incident is
  /// linked to -- e.g. the correlation ID(s) of the authorization/
  /// tool-invocation chain that triggered this incident's creation. Never
  /// a new FK-backed relation table: `AuditEvent.correlationId` is not
  /// itself a unique/FK-able column (many events legitimately share one
  /// correlation ID), so this is a plain, human-curated reference list, the
  /// same posture `docs/audit-chain.md`'s evidence-export filter already
  /// takes toward `correlationId`.
  relatedCorrelationIds Json @default("[]")

  createdBy String
  creator   UserProfile @relation("IncidentCreations", fields: [createdBy], references: [id])
  createdAt DateTime    @default(now())

  /// Set the moment `status` transitions to `RESOLVED` -- `null` while
  /// `OPEN`/`INVESTIGATING`, and (deliberately) left untouched by a later
  /// transition to `CLOSED` from `RESOLVED` (the *first* resolution time is
  /// what's operationally meaningful -- a resolved-then-reopened-then-
  /// resolved-again incident's `resolvedAt` still reflects this row's
  /// current resolution, since `IncidentsService` only ever sets it on a
  /// transition *into* `RESOLVED`).
  resolvedAt DateTime?

  /// Release 2026-11-11 (brief §3.4): the governed `AiSystem` this
  /// investigation concerns, when one is known. Optional and nullable
  /// on purpose — an incident is often opened from raw audit evidence
  /// before anyone has established which governed system it belongs to,
  /// and forcing a guess at creation time would put fabricated attribution
  /// into the evidence trail.
  aiSystemId String?
  aiSystem   AiSystem? @relation(fields: [aiSystemId], references: [id])

  @@index([status])
  @@index([severity])
  @@index([aiSystemId])
  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Release 2026-11-11 — AI-system inventory and ownership (brief §3.1).
//
// The runtime foundation this product already has (agents, tasks, tools,
// policies, approvals, audit) governs *principals and actions*. It has no
// record of the **business-level AI system or use case** those principals
// serve, and therefore no accountable owner, lifecycle state, or review
// date to hang governance on. `AiSystem` is that record.
//
// Two properties matter more than the field list:
//
//  1. **Declared metadata is not verified discovery.** Everything a human
//     types here (`declaredProvider`, `declaredModel`, the linked agents)
//     is a declaration. Whether that system is actually covered by runtime
//     enforcement is *derived* at read time from real observations — see
//     `AiSystemsService.resolveCoverage`. There is deliberately no stored
//     `coverage` column: a stored one would silently go stale and would let
//     the UI claim coverage this platform cannot prove.
//  2. **Linking an existing agent must not invent or lose ownership.** An
//     `AiSystemAgentLink` is an additive, attributed, reversible assertion
//     that a given `Agent` serves this system. It never rewrites
//     `Agent.createdBy` and never implies the agent had no prior owner.
// ---------------------------------------------------------------------------

/// `AiSystem.lifecycleState` (brief §3.1). Transitions are server-enforced
/// by `AiSystemsService.transitionState` against an explicit allowed-edge
/// table — never a free `PATCH` of this column — and every edge is
/// recorded as an `AiSystemStateTransition` row. `RETIRED` is terminal:
/// retiring is auditable and reversible only by creating a new system,
/// which keeps a retired system's evidence trail meaningful.
enum AiSystemLifecycleState {
  DRAFT
  REVIEW
  ACTIVE
  SUSPENDED
  RETIRED
}

/// Which deployment environment an `AiSystem` runs in. Deliberately a
/// small closed enum rather than free text: the overview's coverage and
/// finding queues filter on it, and a free-text field would fragment into
/// "prod"/"Production"/"PROD" within a week.
enum AiSystemEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

/// A governed AI system or use case — the business-level unit an
/// accountable owner is answerable for, and the record findings,
/// investigations, assessments, and evidence attach to. See this section's
/// header comment for why coverage is derived rather than stored.
model AiSystem {
  id   String @id @default(uuid())
  /// URL-safe stable identifier, unique per tenant database (which is
  /// unique globally in effect — see `Agent.identifier`'s doc comment for
  /// the same reasoning). Immutable after creation: it appears in shared
  /// deep links and exported evidence bundles.
  slug String @unique

  name            String
  /// What this system is *for*, in business terms. Required — a system
  /// nobody can describe cannot be governed, and an empty purpose is the
  /// single most common way an inventory decays into a list of names.
  businessPurpose String

  /// The accountable owner. A real `UserProfile` FK, not free text: the
  /// overview's "overdue decisions" queue and finding assignment both need
  /// a resolvable principal, and an owner who has left the tenant must
  /// surface as a broken link rather than as a plausible-looking string.
  ownerId String
  owner   UserProfile @relation("AiSystemOwnership", fields: [ownerId], references: [id])

  businessUnit String

  environment    AiSystemEnvironment
  lifecycleState AiSystemLifecycleState @default(DRAFT)

  /// The classification of data this system is *declared* to handle —
  /// reuses Phase 15a's `DataClassification` (never a parallel scale) so a
  /// system's declared classification and a `ToolAction`'s enforced
  /// classification are directly comparable, which is what makes a
  /// "declared INTERNAL, observed touching RESTRICTED actions" finding
  /// expressible at all.
  dataClassification DataClassification @default(INTERNAL)

  /// The provider/model the owner *declares* this system uses (e.g.
  /// `"anthropic"` / `"claude-opus-4"`). Declared, never verified — the
  /// API's own configured provider is a separate fact, and any drift
  /// between the two is itself a governance finding rather than something
  /// this column should quietly reconcile.
  declaredProvider String?
  declaredModel    String?

  /// Why this system carries the risk posture it does, in the owner's own
  /// words. Required for the same reason `businessPurpose` is.
  riskRationale String

  /// When this system's governance record is next due for review. Drives
  /// the overview's overdue-review queue; `null` means no review has been
  /// scheduled, which the UI must render as *unscheduled*, never as "not
  /// due".
  nextReviewDate DateTime?

  /// Monotonic counter incremented by `AiSystemsService` on every
  /// *material* change (see `AiSystemVersion`). Not a Prisma
  /// `@updatedAt`-style field and not an optimistic-concurrency token —
  /// it is the version number an evidence export cites.
  version Int @default(1)

  createdAt DateTime    @default(now())
  createdBy String
  creator   UserProfile @relation("AiSystemCreations", fields: [createdBy], references: [id])
  updatedAt DateTime    @updatedAt

  versions    AiSystemVersion[]
  agentLinks  AiSystemAgentLink[]
  toolLinks   AiSystemToolLink[]
  transitions AiSystemStateTransition[]
  incidents   Incident[]

  @@index([lifecycleState])
  @@index([environment])
  @@index([ownerId])
  @@index([nextReviewDate])
  @@map("ai_systems")
}

/// An immutable snapshot of an `AiSystem`'s governed fields taken *before*
/// each material change, with the reason and the human who made it. This
/// is what "version material changes and retain their provenance" (brief
/// §3.1) means concretely: the current row is the live record, and this
/// table is the history an auditor reads. Never updated or deleted by
/// application code.
model AiSystemVersion {
  id         String   @id @default(uuid())
  aiSystemId String
  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id])

  /// The `AiSystem.version` value this snapshot *replaces* — i.e. the
  /// state as it was before the change that produced version `version + 1`.
  version Int

  /// The full governed field set as it stood at `changedAt`, canonicalized
  /// the same way audit event data is. Stored as a snapshot rather than a
  /// field-level diff so a reader never has to replay the whole history to
  /// answer "what did this record say on 3 October".
  snapshot Json

  /// Free text from the person making the change. Required — an unexplained
  /// material change to a governance record is not evidence of anything.
  changeReason String

  changedBy String
  changer   UserProfile @relation("AiSystemVersionAuthorship", fields: [changedBy], references: [id])
  changedAt DateTime    @default(now())

  @@unique([aiSystemId, version])
  @@index([aiSystemId, changedAt])
  @@map("ai_system_versions")
}

/// An attributed, reversible assertion that a given `Agent` serves a given
/// `AiSystem`. See this section's header comment for why this never
/// rewrites the agent's own ownership fields.
model AiSystemAgentLink {
  id         String   @id @default(uuid())
  aiSystemId String
  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  linkedBy String
  linker   UserProfile @relation("AiSystemAgentLinks", fields: [linkedBy], references: [id])
  linkedAt DateTime    @default(now())

  @@unique([aiSystemId, agentId])
  @@index([agentId])
  @@map("ai_system_agent_links")
}

/// The same additive assertion for a registered `Tool`. Kept separate from
/// `AiSystemAgentLink` rather than modelled as one polymorphic "asset link"
/// row: the two have genuinely different downstream uses (agents drive
/// runtime-coverage derivation, tools drive classification/destination
/// analysis), and a polymorphic table would force every consumer to
/// re-narrow the type.
model AiSystemToolLink {
  id         String   @id @default(uuid())
  aiSystemId String
  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id])

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id])

  linkedBy String
  linker   UserProfile @relation("AiSystemToolLinks", fields: [linkedBy], references: [id])
  linkedAt DateTime    @default(now())

  @@unique([aiSystemId, toolId])
  @@index([toolId])
  @@map("ai_system_tool_links")
}

/// One server-enforced lifecycle edge, recorded whether or not it also
/// produced an `AiSystemVersion`. Separate from `AiSystemVersion` because
/// the two answer different questions ("who changed the declared model" vs
/// "who put this system into production"), and because the
/// separation-of-duties rule applies only to the latter.
model AiSystemStateTransition {
  id         String   @id @default(uuid())
  aiSystemId String
  aiSystem   AiSystem @relation(fields: [aiSystemId], references: [id])

  fromState AiSystemLifecycleState
  toState   AiSystemLifecycleState

  /// Required for every transition. The reviewer's justification is the
  /// evidence an assessment later cites.
  reason String

  actorId String
  actor   UserProfile @relation("AiSystemTransitions", fields: [actorId], references: [id])
  at      DateTime    @default(now())

  @@index([aiSystemId, at])
  @@map("ai_system_state_transitions")
}

/// docs/edge.md: one hostname an agent may reach through the Manar edge egress proxy. Added and
/// removed only by a person (tenant admin, JWT); projected into the platform's `EdgePeer.allowHosts`.
model AgentEgressRule {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])
  /// A lowercase DNS name, or `*.` + a DNS name (one label or more). No IPs, ports or paths.
  host    String
  reason  String?

  /// `UserProfile.id` of the person who added it.
  createdBy String
  createdAt DateTime @default(now())

  @@unique([agentId, host])
  @@map("agent_egress_rules")
}

/// docs/edge.md: gateway event batches (UUID per batch) already recorded in this tenant. Written in
/// the same transaction as the batch's audit events, so a retried batch is recorded once and a crash
/// loses nothing. Rows older than a day are deleted by the next batch.
model EdgeEventBatch {
  batchId   String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("edge_event_batches")
}

// ---------------------------------------------------------------------------
// Hosts (R2 F2a, docs/hosts.md): machines between the tenant and its agents.
// ---------------------------------------------------------------------------

enum OrgUnitSource {
  MANUAL
  ENTRA
  AD
}

/// A department or sub-department: a tree inside the tenant. Synced from
/// AD/Entra in F2b; managed by hand until then.
model OrgUnit {
  id         String        @id @default(uuid())
  name       String
  parentId   String?
  parent     OrgUnit?      @relation("OrgUnitTree", fields: [parentId], references: [id])
  children   OrgUnit[]     @relation("OrgUnitTree")
  /// The directory's own id (Entra group id, AD OU objectGUID) when synced.
  externalId String?       @unique
  source     OrgUnitSource @default(MANUAL)
  hostGroups HostGroup[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([parentId])
  @@map("org_units")
}

/// Hosts that share policy defaults and rollout settings (e.g. "Dev workstations").
model HostGroup {
  id            String             @id @default(uuid())
  name          String             @unique
  orgUnitId     String?
  orgUnit       OrgUnit?           @relation(fields: [orgUnitId], references: [id])
  hosts         Host[]
  installKeys   InstallKey[]
  approvalRules HostApprovalRule[]
  adcsSettings  AdcsSettings[]
  adOuRules     AdOuRule[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("host_groups")
}

/// A registration-only secret scoped to one host group. Stored as SHA-256 of
/// the raw key, which is shown once. Grants no identity and no access.
model InstallKey {
  id           String    @id @default(uuid())
  hostGroupId  String
  hostGroup    HostGroup @relation(fields: [hostGroupId], references: [id])
  keyHash      String    @unique
  label        String
  /// Empty means any address.
  allowedCidrs String[]
  maxUses      Int?
  uses         Int       @default(0)
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([hostGroupId])
  @@map("install_keys")
}

enum HostStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum HostKeyType {
  TPM
  SOFTWARE
}

/// One machine, unique per tenant by `machineId` (its certificate names
/// `host://<tenantSlug>/<machineId>`). Re-registration merges into this row
/// (VDI golden images register on every boot); a different key or a key
/// from another group waits as a pending rekey for an admin (docs/hosts.md).
model Host {
  id               String            @id @default(uuid())
  hostGroupId      String
  hostGroup        HostGroup         @relation(fields: [hostGroupId], references: [id])
  machineId        String
  hostname         String
  os               String
  keyType          HostKeyType
  status           HostStatus        @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  lastSeenAt       DateTime?
  registeredFromIp String
  /// SHA-256 of the SubjectPublicKeyInfo the machine is bound to.
  keyFingerprint   String
  /// A registration with a different key, or a key of another group, waits
  /// here for an admin; nothing about the bound machine changes meanwhile.
  pendingKeyFingerprint String?
  pendingHostGroupId    String?
  /// `INSTALL_KEY` or `ADCS` (computer certificate; the OU decides the group).
  enrolmentMethod  String            @default("INSTALL_KEY")
  /// ADCS hosts: the certificate's DNS name and the DN last read from AD.
  adcsDnsName      String?
  adDn             String?
  adDnCheckedAt    DateTime?
  /// The host key passed TPM credential activation (bound to `keyFingerprint`).
  tpmVerified      Boolean           @default(false)
  tpmEkFingerprint String?
  /// Keycloak subject of the person whose install key enrolled this machine; null for hosts
  /// enrolled before this column existed and for key-less (ADCS) enrolment.
  ownerSubject     String?
  /// The install key that enrolled (or last re-enrolled) it: the first-run screen matches the
  /// device it waits for by this, never by time.
  installKeyId     String?
  certificates     HostCertificate[]
  tools            HostTool[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([machineId])
  /// One computer identity, one host (lower-cased certificate DNS name; nulls repeat).
  @@unique([adcsDnsName])
  @@index([hostGroupId])
  @@index([status])
  @@map("hosts")
}

/// One AI tool found on one device (launch spec 4.5), reported by the device on
/// `POST /host/v1/inventory`. `desiredProtection` is the owner's choice from the console; the
/// device reads it from `GET /host/v1/config` and reports back what it did.
model HostTool {
  id                String   @id @default(uuid())
  hostId            String
  host              Host     @relation(fields: [hostId], references: [id])
  /// Catalogue id (`host.cursor`) or `other:<slug>` for an unknown tool.
  toolId            String
  name              String
  version           String?
  path              String?
  protected         Boolean  @default(false)
  /// `hook`, `mcp`, `gateway` or `none`.
  protectMode       String   @default("none")
  desiredProtection Boolean  @default(true)
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())

  @@unique([hostId, toolId])
  @@index([toolId])
  @@map("host_tools")
}

model HostCertificate {
  id           String    @id @default(uuid())
  hostId       String
  host         Host      @relation(fields: [hostId], references: [id])
  serialNumber String    @unique
  notBefore    DateTime
  notAfter     DateTime
  revokedAt    DateTime?
  /// When OpenBao confirmed the revocation; null with `revokedAt` set = retry.
  caRevokedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([hostId])
  @@map("host_certificates")
}

/// Auto-approves a newly registered host when every set condition matches.
model HostApprovalRule {
  id              String     @id @default(uuid())
  /// Null: applies to every group.
  hostGroupId     String?
  /// Restrict: deleting a group must never turn its rules into global ones.
  hostGroup       HostGroup? @relation(fields: [hostGroupId], references: [id], onDelete: Restrict)
  /// Glob over the hostname (`*` and `?`), case-insensitive.
  hostnamePattern String?
  /// Empty means any address.
  cidrs           String[]
  /// Verified TPM only (credential activation), not the installer's claim.
  requireTpm      Boolean    @default(false)
  /// A computer certificate from a CA the tenant trusts, not revoked.
  requireAdcs     Boolean    @default(false)
  /// The host's DN, read from AD, is at or under this OU.
  adOuDn          String?
  enabled         Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("host_approval_rules")
}

/// A customer CA certificate the tenant trusts for key-less host enrolment.
model AdcsTrustedCa {
  id          String   @id @default(uuid())
  label       String
  certPem     String
  subject     String
  /// SHA-256 of the DER certificate.
  fingerprint String   @unique
  notAfter    DateTime
  createdBy   String
  createdAt   DateTime @default(now())

  @@map("adcs_trusted_cas")
}

/// One row per tenant (`id = 'default'`). The bind password is in OpenBao KV, never here.
model AdcsSettings {
  id                 String    @id @default("default")
  /// Receives ADCS hosts whose OU is unmapped or unknown (they stay PENDING).
  defaultHostGroupId String
  defaultHostGroup   HostGroup @relation(fields: [defaultHostGroupId], references: [id])
  ldapsUrl           String?
  baseDn             String?
  bindDn             String?
  /// CA that signed the LDAPS server certificate (verification is mandatory).
  serverCaPem        String?
  /// Certificate template OIDs (extension 1.3.6.1.4.1.311.21.7) accepted for key-less enrolment. Empty: none.
  allowedTemplateOids String[] @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("adcs_settings")
}

/// AD OU (DN suffix, longest match wins) to host group.
model AdOuRule {
  id          String    @id @default(uuid())
  ouDn        String
  /// Lower-cased, trimmed form; unique so one OU has one rule.
  ouDnKey     String    @unique
  hostGroupId String
  hostGroup   HostGroup @relation(fields: [hostGroupId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([hostGroupId])
  @@map("ad_ou_rules")
}

/// A TPM manufacturer (or intermediate) root the tenant accepts for EK certificates.
model TpmTrustRoot {
  id          String   @id @default(uuid())
  label       String
  certPem     String
  subject     String
  fingerprint String   @unique
  notAfter    DateTime
  /// 'EK' (manufacturer EK certificates) or 'AK' (vendor AK certificates, e.g. Azure vTPM); never mixed.
  purpose     String   @default("EK")
  createdBy   String
  createdAt   DateTime @default(now())

  @@map("tpm_trust_roots")
}

/// One credential-activation round: the secret is kept only as a hash.
model TpmChallenge {
  id             String    @id @default(uuid())
  machineId      String
  /// SHA-256 of the SPKI of the key the TPM named; must equal the CSR key at registration.
  keyFingerprint String
  ekFingerprint  String
  secretHash     String
  attemptsLeft   Int       @default(3)
  expiresAt      DateTime
  verifiedAt     DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
  @@map("tpm_challenges")
}
