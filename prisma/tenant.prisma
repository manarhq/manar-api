// Tenant DB schema.
//
// Every tenant gets a fully isolated Postgres database generated from this
// schema (see TenantDatabaseManager.provisionTenant). Phase 2 shipped this
// file with datasource/generator blocks only and no models — deliberately,
// to avoid inventing placeholder domain models just to have "something to
// test" (isolation was proven structurally instead, see
// docs/tenant-isolation.md). Phase 3 (Human Authentication) adds the first
// real models: a local projection of each tenant's Keycloak-authenticated
// users and their coarse role assignments — see docs/human-auth.md.
// Phase 4 (Agent Identity & Enrollment) adds agents as independent security
// principals with X.509-based workload identity — see docs/agent-identity.md.
datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/tenant-client"
  // See prisma/control.prisma's generator block for why this is forced to
  // cjs — this project is CommonJS, Prisma 7 defaults to ESM output.
  moduleFormat = "cjs"
}

/// The eight application roles (Section 11 of the master prompt). Values
/// must match `src/auth/roles.ts`'s `ROLES` constant, and the Keycloak
/// realm role names `TenantProvisioningService` seeds for every tenant,
/// character-for-character — see that file's doc comment for why there is
/// deliberately no translation layer between the three.
enum Role {
  TENANT_OWNER
  SECURITY_ADMIN
  AI_GOVERNANCE_MANAGER
  SOC_OPERATOR
  APPROVER
  AUDITOR
  DEVELOPER
  READ_ONLY
}

/// A local projection of a Keycloak-authenticated human identity — never a
/// credential store (Manar's own code never stores or sees passwords;
/// Keycloak owns credentials entirely). Rows are found-or-created by
/// `JwtAuthGuard` the first time a given `keycloakSubject` (the JWT `sub`
/// claim) is seen for this tenant.
model UserProfile {
  id              String @id @default(uuid())
  keycloakSubject String @unique

  email       String
  displayName String

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  roleBindings RoleBinding[]

  /// Phase 4: agents/enrollment tokens this user has created — "createdBy"
  /// is a free-text-adjacent audit trail elsewhere in this schema (see
  /// RoleBinding.grantedBy's doc comment for the precedent), but here it's
  /// a real FK since agent creation is always attributable to an
  /// authenticated Manar user (JwtAuthGuard's AuthContext), never a
  /// Keycloak-side actor.
  createdAgents           Agent[]
  createdEnrollmentTokens AgentEnrollmentToken[]

  /// Phase 5: every Task ultimately traces back to a human requester — even
  /// a delegated child Task's `requesterId` is the *root* task's original
  /// requester (see docs/task-delegation.md), never the delegating agent
  /// (Task.requesterId is a UserProfile FK; an agent has no UserProfile
  /// row). This is what makes the Human → Task → Agent → Task → Agent
  /// chain fully reconstructable per Section 20.
  requestedTasks Task[]

  /// Phase 6: every PolicyVersion (DRAFT or PUBLISHED) records the human
  /// who authored it — see PolicyVersion's doc comment.
  authoredPolicyVersions PolicyVersion[]

  /// Phase 8: every ApprovalDecision this user has made (APPROVE/DENY) —
  /// see that model's doc comment.
  approvalDecisions ApprovalDecision[]

  @@map("user_profiles")
}

/// Coarse role assignment, checked by `RolesGuard`/`@RequireRole(...)`.
/// Fine-grained, resource-scoped authorization is a later phase (OpenFGA,
/// Phase 5) — not built here. A user can hold multiple roles.
model RoleBinding {
  id     String      @id @default(uuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [id])

  role Role

  grantedAt DateTime @default(now())
  /// Free-text identifier of who/what granted this role (a Keycloak admin
  /// username, or "system:bootstrap" for the first role a newly-seen user
  /// is granted). Not a foreign key to UserProfile — the granter need not
  /// be a Manar user at all (e.g. a Keycloak-side realm admin).
  grantedBy String

  @@unique([userId, role])
  @@map("role_bindings")
}

/// Agent lifecycle state (Phase 4, Section 13-17 of the master prompt).
/// PENDING_ENROLLMENT: created by a human, no working certificate yet.
/// ACTIVE: has passed enrollment (POST /agents/enroll) with a valid,
/// unrevoked certificate. REVOKED: `CertificateAuthorityService.revoke`
/// ran — the agent's certificate no longer authenticates on the mTLS
/// surface (AgentMtlsGuard checks this on every request, not just at TLS
/// handshake time — see docs/agent-identity.md). KILLED is reserved for a
/// later, dedicated kill-switch phase (Section 32) — not set by anything
/// in this phase, kept here now so that later phase avoids a destructive
/// migration to extend this enum.
enum AgentStatus {
  PENDING_ENROLLMENT
  ACTIVE
  REVOKED
  KILLED
}

/// An agent: an independent security principal with workload identity
/// based on asymmetric crypto + an X.509 certificate (never a shared
/// secret/API key). `identifier` is this agent's SPIFFE-like identity URI
/// (`agent://<tenantSlug>/<slug>`) — the exact string
/// `CertificateAuthorityService` requires an enrollment CSR's Subject
/// Alternative Name to match before it will ever ask OpenBao to sign
/// anything, and the same string `AgentMtlsGuard` looks up an mTLS
/// request's verified client certificate by. Unique per tenant database,
/// so unique globally in effect (Phase 2's isolation model: there is no
/// shared table for two tenants' agents to collide in).
model Agent {
  id          String      @id @default(uuid())
  slug        String      @unique
  identifier  String      @unique
  displayName String
  status      AgentStatus @default(PENDING_ENROLLMENT)

  /// Unused until Phase 5+ (agent capabilities/task scoping is explicitly
  /// out of scope this phase) — kept minimal (an empty object) rather than
  /// omitted so that phase doesn't need a destructive migration to add it.
  capabilities Json @default("{}")

  createdAt DateTime    @default(now())
  createdBy String
  creator   UserProfile @relation(fields: [createdBy], references: [id])

  groupMemberships AgentGroupMembership[]
  enrollmentTokens AgentEnrollmentToken[]
  certificates     AgentCertificate[]

  /// Phase 5: tasks currently assigned to this agent — an agent's *only*
  /// source of authority (Section 18: agents start with effectively zero
  /// useful permanent authority; `capabilities` above stays unused this
  /// phase too). See docs/authorization-model.md.
  assignedTasks Task[]

  /// Phase 7b: every tool call this agent has actually made (or attempted)
  /// through `CredentialBrokerService` — see `ToolInvocation`'s own doc
  /// comment.
  toolInvocations ToolInvocation[]

  /// Phase 8: every ApprovalRequest/AuthorizationGrant naming this agent as
  /// the one that would (or did) execute the pending action — see those
  /// models' own doc comments.
  approvalRequests    ApprovalRequest[]
  authorizationGrants AuthorizationGrant[]

  @@map("agents")
}

/// Minimal this phase — membership only, no group-based policy yet (that's
/// Phase 5+, alongside agent capabilities/task scoping).
model AgentGroup {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())

  memberships AgentGroupMembership[]

  @@map("agent_groups")
}

model AgentGroupMembership {
  id String @id @default(uuid())

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id])

  groupId String
  group   AgentGroup @relation(fields: [groupId], references: [id])

  addedAt DateTime @default(now())

  @@unique([agentId, groupId])
  @@map("agent_group_memberships")
}

/// A single-use enrollment token (Section 14). The raw token is only ever
/// returned once, at creation time (`POST /agents/:id/enrollment-tokens`'s
/// response) — never stored or retrievable again. `tokenHash` is what's
/// persisted (see `src/agents/enrollment-token.util.ts` for the hashing
/// scheme), so a control/tenant DB compromise alone can't be used to
/// enroll an agent. `expiresAt` is short (15 minutes — see
/// `AgentsService.ENROLLMENT_TOKEN_TTL_MS`); `usedAt` enforces single-use:
/// once set, a second enrollment attempt with the same token is rejected
/// even if it somehow leaked.
model AgentEnrollmentToken {
  id String @id @default(uuid())

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id])

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime    @default(now())
  createdBy String
  creator   UserProfile @relation(fields: [createdBy], references: [id])

  @@map("agent_enrollment_tokens")
}

/// Metadata for a certificate `CertificateAuthorityService` has issued.
/// Never stores the private key (it never leaves the enrolling agent — see
/// packages/sdk-node) or the full certificate PEM (OpenBao is the system
/// of record for the certificate material itself; this row is what lets
/// `AgentMtlsGuard` check "is this specific serial revoked" without a
/// round-trip to OpenBao on every mTLS request — defense in depth beyond
/// the TLS layer's own chain validation, since a cert can be individually
/// revoked before its `notAfter`).
model AgentCertificate {
  id String @id @default(uuid())

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id])

  /// Canonical form: uppercase hex, no separators (see
  /// `certificate-authority.service.ts`'s serial-number normalization doc
  /// comment for why this differs from OpenBao's own colon-separated
  /// format).
  serialNumber String @unique
  subject      String

  notBefore DateTime
  notAfter  DateTime

  revokedAt        DateTime?
  revocationReason String?

  createdAt DateTime @default(now())

  @@map("agent_certificates")
}

/// Task lifecycle state (Phase 5, Sections 18-20). A new task goes straight
/// to ACTIVE at creation — there is no approval step yet (Phase 6/8), so
/// PENDING is never actually set by anything this phase; it's kept in the
/// enum now (rather than added later) for the same reason `AgentStatus.KILLED`
/// was kept unused ahead of its own phase — avoids a destructive migration
/// once approvals land. EXPIRED/COMPLETED are likewise not transitioned to
/// by any code this phase: expiry is enforced by comparing `expiresAt`
/// against `now` at authorization time, not by a background job flipping
/// status (see docs/authorization-model.md — this is deliberate, it's what
/// the "expired task denies even though its OpenFGA tuples still exist"
/// test proves). REVOKED is the one status this phase's code actually
/// sets (`POST /tasks/:id/revoke`), and is central to the revocation-cascade
/// invariant: revoking a task must immediately invalidate every descendant
/// task's authorization, enforced by AuthorizationService walking the live
/// ancestor chain on every check — never by cascading a write to
/// descendants (Section 20).
enum TaskStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  COMPLETED
}

/// A narrowly-scoped, expiring grant of authority to exactly one agent
/// (Sections 18-20 of the master prompt) — the *only* way an agent ever
/// gets to do anything: agents start with zero permanent authority
/// (`Agent.capabilities` stays an unused empty object forever), and every
/// action an agent takes is authorized against the task it's currently
/// assigned to, never against the agent itself.
///
/// `allowedToolActions`/`allowedResourceSelectors`/`forbiddenActions` are
/// the human/audit-readable record of what was granted — Postgres columns,
/// queryable/diffable in the ordinary way. The *enforcement* substrate
/// `AuthorizationService` actually checks against is a mirrored set of
/// OpenFGA relationship tuples, written at task-creation/delegation time by
/// `TaskGrantSyncService` (see docs/authorization-model.md for the full
/// modeling rationale and why these are kept in sync rather than treated as
/// two independent sources of truth for the same decision).
///
/// `parentTaskId` is the self-referencing edge `AuthorizationService` walks
/// (recursively, on every authorization check — Section 20's real-time
/// revocation-cascade mechanism) to confirm every ancestor task is still
/// ACTIVE/unexpired/under its own execution limit. `TaskDelegation` exists
/// *alongside* this FK purely to make the delegation chain queryable/
/// auditable as a first-class row without walking the self-FK — see that
/// model's own doc comment.
model Task {
  id          String  @id @default(uuid())
  name        String
  description String?

  /// The human who ultimately requested this task. For a root task, the
  /// human who called `POST /tasks`. For a *delegated* (child) task, this
  /// is deliberately still the root task's original requester (resolved by
  /// walking `parentTaskId` to the top), never the delegating agent — an
  /// agent has no `UserProfile` row to point this FK at, and Section 20's
  /// full reconstructable chain (Human → Task → Agent → Task → Agent → …)
  /// depends on every task in the chain tracing back to the same
  /// originating human. See docs/task-delegation.md.
  requesterId String
  requester   UserProfile @relation(fields: [requesterId], references: [id])

  /// The *only* agent that may exercise this task's grants — permission
  /// flows through the task, never attached to the agent directly (Section
  /// 18). `AgentMtlsGuard`-resolved `AgentContext.agent.id` must match this
  /// exactly before `AuthorizationService` even reaches OpenFGA (step 1 of
  /// the authorize pipeline).
  assignedAgentId String
  assignedAgent   Agent  @relation(fields: [assignedAgentId], references: [id])

  /// Self-referencing edge for the ancestor chain (see model doc comment).
  /// Null for a root task.
  parentTaskId String?
  parentTask   Task?   @relation("TaskParent", fields: [parentTaskId], references: [id])
  childTasks   Task[]  @relation("TaskParent")

  /// `{ toolId, actionId }[]` — the set of tool actions this task may
  /// invoke. Crossed with `allowedResourceSelectors` (matched by `toolId`)
  /// at tuple-write time to produce the concrete grant set — see
  /// `src/authorization/grant-triples.ts`.
  allowedToolActions Json @default("[]")

  /// `{ toolId, pattern }[]` — the resources each tool action above may
  /// touch. `pattern` is either a literal resource identifier or the
  /// literal wildcard string `"*"` ("any resource for this tool action") —
  /// this phase deliberately does not implement glob/prefix pattern
  /// matching (that's real policy-engine territory, Phase 6/8's scope, not
  /// this phase's relationship-authorization engine); see
  /// docs/authorization-model.md's "known limitation" section.
  allowedResourceSelectors Json @default("[]")

  /// `{ toolId, actionId }[]` — explicit denies that win over
  /// `allowedToolActions` even for an otherwise-matching grant (checked
  /// before OpenFGA is ever called — step 4 of the authorize pipeline —
  /// *and* mirrored into OpenFGA's own tuples as a `but not` exclusion, so
  /// the deny is enforced from both angles, not just the faster app-layer
  /// short-circuit).
  forbiddenActions Json @default("[]")

  status TaskStatus @default(ACTIVE)

  startsAt       DateTime  @default(now())
  expiresAt      DateTime
  maxExecutions  Int?
  /// Incremented atomically (a single conditional `UPDATE`, closing the
  /// same race `AgentEnrollmentToken`'s single-use claim closes — see
  /// `AgentsService.enroll`'s doc comment) on every ALLOW decision. Never
  /// decremented; there is no notion of "returning" a used execution.
  executionCount Int       @default(0)

  /// 0-100, conservative default. Not enforced by anything this phase (no
  /// risk scoring yet — Phase 6/8) — captured now so that phase doesn't
  /// need a destructive migration to add it, matching this codebase's
  /// established precedent (e.g. `Tenant.residency` in Phase 2).
  riskCeiling Int @default(20)

  createdAt DateTime @default(now())

  delegationsAsParent TaskDelegation[] @relation("DelegationParent")
  delegationAsChild   TaskDelegation?  @relation("DelegationChild")

  /// Phase 7b: every tool call actually attempted under this task — see
  /// `ToolInvocation`'s own doc comment.
  toolInvocations ToolInvocation[]

  /// Phase 8: every ApprovalRequest/AuthorizationGrant issued for an
  /// action under this task — see those models' own doc comments.
  approvalRequests    ApprovalRequest[]
  authorizationGrants AuthorizationGrant[]

  @@map("tasks")
}

/// Exists purely to make the delegation chain queryable/auditable as a
/// first-class row independent of walking `Task.parentTaskId` — kept thin
/// per the design spec ("exists mainly to make the delegation chain
/// queryable/auditable... keep it thin"). `Task.parentTaskId` (set on the
/// child at creation time) is what `AuthorizationService` actually walks at
/// authorization-check time; this table is not consulted on that hot path.
model TaskDelegation {
  id String @id @default(uuid())

  parentTaskId String
  parentTask   Task @relation("DelegationParent", fields: [parentTaskId], references: [id])

  /// One parent may delegate to many children over time, but each child
  /// task has exactly one delegation record (it has exactly one
  /// `parentTaskId`) — `@unique` makes that structural, not just a
  /// convention.
  childTaskId String @unique
  childTask   Task   @relation("DelegationChild", fields: [childTaskId], references: [id])

  createdAt DateTime @default(now())

  @@map("task_delegations")
}

/// A `PolicyVersion`'s lifecycle (Phase 6, Sections 21-22). A new version
/// always starts DRAFT — never enforced by `PolicyEngine` (see that
/// module's doc comment) until it's explicitly PUBLISHED via `POST
/// /policies/:id/versions/:versionId/publish`. There is no third
/// state: a published version is never un-published, edited, or deleted —
/// superseding one always means publishing a *new* version (`version`
/// n+1), never mutating this one in place (see PolicyVersion's own doc
/// comment).
enum PolicyVersionStatus {
  DRAFT
  PUBLISHED
}

/// A named, versioned policy — Phase 6's deterministic org-defined
/// restriction layered *on top of* an already-OpenFGA-permitted action
/// (see docs/policy-model.md and docs/authorization-model.md for how this
/// relates to Phase 5's task-scope authorization, which this phase does
/// NOT re-decide). `name` is unique per tenant database, so effectively
/// globally unique (Phase 2's per-tenant database isolation model — see
/// docs/tenant-isolation.md).
///
/// A `Policy` row itself carries no rule content — that lives entirely on
/// its `PolicyVersion`s (immutable once published). "The policy's current
/// content" always means "the latest PUBLISHED PolicyVersion for this
/// Policy" (`PolicyEngine.evaluate` resolves this per policy, per tenant,
/// on every authorization check — see that module's doc comment for why
/// this is a live per-request DB read rather than a cached snapshot this
/// phase).
model Policy {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())

  versions PolicyVersion[]

  @@map("policies")
}

/// One immutable, content-addressed snapshot of a `Policy`'s rule set
/// (Sections 21-22 — "GUI/YAML/JSON must manipulate the same underlying
/// model; published versions are immutable"). `content` is the declarative
/// rule set this version represents — see docs/policy-model.md for the
/// schema (`src/policy/policy-content.schema.ts`'s `PolicyContentSchema`)
/// and `src/policy/policy-content-codec.ts` for the YAML⇄JSON round-trip
/// that produces it identically regardless of which format an author
/// submitted.
///
/// **Published versions are never mutated or deleted** — there is
/// deliberately no update/delete endpoint for one at all (see
/// `src/policy/policy.controller.ts`'s doc comment); editing a published
/// policy always means creating version n+1 via `POST
/// /policies/:id/versions`, and a rollback is likewise a *new* version
/// (n+1) whose `content` happens to match an older version's — never an
/// in-place revert — with `reason` explicitly saying so and
/// `previousVersionId` still pointing at the version immediately before it
/// in this policy's chain (not at the older version being rolled back to),
/// so the full chain stays linear and auditable end to end.
///
/// `version` is a monotonically increasing integer, unique per `policyId`
/// (`@@unique([policyId, version])`) — the *n*-th version ever created for
/// this policy, DRAFT or PUBLISHED alike; `PolicyEngine` only ever
/// consults the PUBLISHED one with the highest `version`.
model PolicyVersion {
  id String @id @default(uuid())

  policyId String
  policy   Policy @relation(fields: [policyId], references: [id])

  version Int
  status  PolicyVersionStatus @default(DRAFT)

  /// The declarative rule set itself — see docs/policy-model.md. Validated
  /// against `PolicyContentSchema` before this row is ever written
  /// (`PolicyService`); `PolicyEngine` re-validates on every read anyway
  /// (fail-closed — see that module's doc comment on why "can't parse
  /// stored content" is a genuine failure, distinct from "no rule
  /// matched").
  content Json

  /// sha256 hex of `content` after deterministic canonicalization (key
  /// order does not affect this value — see
  /// `src/policy/policy-content-codec.ts`'s `computeContentHash`). Proves a
  /// YAML submission and its JSON equivalent produce byte-identical stored
  /// intent, and lets a caller cheaply confirm "is this the version I
  /// think it is" without diffing the full `content` blob.
  contentHash String

  authorId String
  author   UserProfile @relation(fields: [authorId], references: [id])

  /// Free-text: why this version was created (a normal edit's rationale,
  /// or an explicit "Rollback to version N" for a rollback — see model doc
  /// comment). Optional for a policy's very first version.
  reason String?

  /// Self-FK to the version immediately preceding this one in this
  /// policy's chain at creation time (null only for a policy's first
  /// version) — *always* the chain predecessor, even for a rollback (whose
  /// `content` is copied from some *older*, not-necessarily-immediate
  /// version — see model doc comment). This is what keeps the full
  /// version history a single unbroken, auditable chain regardless of how
  /// many rollbacks occur.
  previousVersionId String?
  previousVersion   PolicyVersion?  @relation("PolicyVersionChain", fields: [previousVersionId], references: [id])
  supersededBy      PolicyVersion[] @relation("PolicyVersionChain")

  /// Set exactly once, the moment `POST
  /// /policies/:id/versions/:versionId/publish` transitions this row
  /// DRAFT → PUBLISHED. Null for a DRAFT.
  publishedAt DateTime?

  createdAt DateTime @default(now())

  /// Phase 8: an ApprovalRequest/AuthorizationGrant may record which
  /// PolicyVersion was published at the moment it was produced — nullable
  /// on both, since a REQUIRE_APPROVAL decision can also come purely from
  /// RiskEngine's score exceeding `task.riskCeiling` with no policy rule
  /// having matched at all (see `AuthorizationService`'s
  /// `risk_ceiling_exceeded` reason) — see those models' own doc comments.
  approvalRequests    ApprovalRequest[]
  authorizationGrants AuthorizationGrant[]

  @@unique([policyId, version])
  @@map("policy_versions")
}

/// Which wire protocol `ToolProtocolAdapter` implementation
/// `CredentialBrokerService` dispatches a `Tool`'s invocations to (Phase
/// 7b, Sections 33-35). `HTTP` -> `HttpToolAdapter` (a real outbound HTTP
/// call to `Tool.baseEndpoint`). `MCP` -> `McpToolAdapter` (a real Model
/// Context Protocol client, connecting to `Tool.baseEndpoint` as an MCP
/// server URL) — both protocols go through the *identical*
/// `CredentialBrokerService`/`AuthorizationService` pipeline; there is no
/// separate, weaker path for MCP. See docs/tool-gateway.md and
/// docs/mcp.md.
enum ToolProtocol {
  HTTP
  MCP
}

/// A registered tool a task's grants may authorize an agent to call —
/// Sections 33-35's first-class tool registry (there was none before this
/// phase; `toolId`/`actionId` were opaque, caller-supplied strings
/// throughout Phase 5/6 — see docs/authorization-model.md's "out of scope"
/// note). `name` is unique per tenant database (Phase 2's per-tenant
/// isolation model — see docs/tenant-isolation.md), and is what a Task's
/// `allowedToolActions[].toolId`/`AuthorizeRequest.toolId` are expected to
/// match against once resolved by `CredentialBrokerService` — OpenFGA/the
/// policy engine still treat `toolId` as an opaque string for their own
/// checks (unchanged this phase, see docs/authorization-model.md), this
/// registry is what `POST /agent/v1/tools/invoke` resolves it against
/// *after* that authorization decision already came back ALLOW.
model Tool {
  id          String  @id @default(uuid())
  name        String  @unique
  /// Free text (e.g. `SIEM`/`EDR`/`IAM`/`FIREWALL`) -- a category label
  /// for human/audit readability only, never matched against by any
  /// authorization or risk logic.
  type        String
  vendor      String?
  description String?

  /// Base URL (`HTTP` protocol) or MCP server URL (`MCP` protocol) this
  /// tool's adapter connects to.
  baseEndpoint String
  protocol     ToolProtocol

  /// A `SecretReferenceDescriptor` (`{ provider, reference }` -- reuses
  /// Phase 2's `SecretProvider` interface, see
  /// `src/database/secret-provider.ts`) naming where this tool's
  /// credential actually lives. `CredentialBrokerService` resolves this
  /// through whichever provider it names (`ENV` or `OPENBAO` this phase)
  /// at invocation time -- the resolved credential value is never itself
  /// stored here, logged, or returned to any caller.
  credentialReference Json

  /// A disabled tool fails every invocation attempt cleanly (Section
  /// 35's explicit "disabled tool -> invocation fails even if
  /// authorization would otherwise allow it" requirement) --
  /// `CredentialBrokerService` checks this *after* `AuthorizationService`
  /// has already ALLOWed, since tool enablement is an operational
  /// concern, not an authorization decision.
  enabled Boolean @default(true)

  /// Free-form operator metadata (e.g. environment, owning team) -- never
  /// interpreted by any code this phase.
  metadata Json @default("{}")

  createdAt DateTime @default(now())

  actions      ToolAction[]
  invocations  ToolInvocation[]

  @@map("tools")
}

/// One invocable action on a `Tool` -- what `AuthorizeRequest.actionId`
/// and `POST /agent/v1/tools/invoke`'s `actionId` both resolve against.
/// `riskBaseScore`/`mutating`/`destructive` are the *real* per-action risk
/// signal `RiskEngine.score` looks up starting this phase, replacing
/// Phase 6's placeholder `actionId` keyword heuristic entirely (see
/// docs/policy-model.md's now-superseded "destructive-keyword heuristic"
/// section and `src/risk/risk-engine.service.ts`).
model ToolAction {
  id          String  @id @default(uuid())
  toolId      String
  tool        Tool    @relation(fields: [toolId], references: [id])
  name        String
  description String?

  /// 0-100 -- this action's baseline risk contribution, looked up by
  /// `RiskEngine.score` and added to its deterministic sum (see
  /// docs/policy-model.md).
  riskBaseScore Int

  /// JSON Schema (plain, not a serialized Zod schema -- Zod schemas
  /// aren't JSON-serializable; JSON Schema is the interoperable, storable
  /// choice, and is what `HttpToolAdapter` validates
  /// `params` against via `ajv` before ever dispatching a request -- see
  /// docs/tool-gateway.md). Optional: a tool action with no meaningful
  /// input (e.g. a zero-argument read) may omit it, in which case no
  /// input validation is performed.
  inputSchema  Json?
  /// JSON Schema describing this action's expected result shape --
  /// documentation/contract only this phase, never validated against
  /// (there is no output-validation requirement in the design spec).
  outputSchema Json?

  /// Whether this action changes state on the target tool -- a real
  /// `RiskEngine`/policy-authoring signal (unlike Phase 6's deleted
  /// keyword heuristic, this is operator-declared truth, not guessed from
  /// the action's name).
  mutating Boolean @default(false)
  /// Whether this action is hard/impossible to reverse (e.g.
  /// `isolate_host`, `delete_user`) -- a stronger signal than `mutating`
  /// alone; both feed `RiskEngine.score` independently (see that
  /// service's doc comment for the exact point values).
  destructive Boolean @default(false)
  /// This action's own default stance on requiring human approval,
  /// independent of anything `PolicyEngine`/`RiskEngine` decide --
  /// carried in the schema for a future phase's policy-authoring
  /// ergonomics (e.g. "pre-fill a new policy rule's effect from this");
  /// not read by `RiskEngine`/`AuthorizationService` this phase (Phase
  /// 6's `REQUIRE_APPROVAL` routing already comes from the policy/risk
  /// pipeline, which stays the single source of truth for that decision
  /// -- see docs/policy-model.md).
  approvalDefault Boolean @default(false)

  createdAt DateTime @default(now())

  invocations ToolInvocation[]

  @@unique([toolId, name])
  @@map("tool_actions")
}

/// Operational record of one attempted tool call (Section 35) --
/// deliberately *not* the tamper-evident audit hash chain (that's Phase
/// 9's scope, see `docs/tool-gateway.md`): just enough to show a call
/// happened, what it targeted, and whether it succeeded, for operational
/// visibility and debugging. Never stores the resolved credential, the
/// raw request body, or the raw response body (any of which might carry
/// secret material) -- `resource`/`status`/timestamps/`errorMessage` are
/// shape/summary only, by construction (`CredentialBrokerService` never
/// has a code path that writes anything else into this table -- see that
/// service's own doc comment and the "credential never leaks" test).
model ToolInvocation {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id])

  actionId String
  action   ToolAction @relation(fields: [actionId], references: [id])

  /// The resource string the invocation targeted (the same `resource`
  /// value passed to `AuthorizationService.authorize`) -- an identifier,
  /// never a full request/response payload.
  resource String

  status ToolInvocationStatus

  startedAt   DateTime
  completedAt DateTime?
  /// Set only on `FAILURE` -- the adapter/broker's own error message
  /// (e.g. "HTTP 503", "tool disabled"), never a raw response body that
  /// might carry secret material.
  errorMessage String?

  createdAt DateTime @default(now())

  @@map("tool_invocations")
}

/// `ToolInvocation.status` -- Section 35 explicitly asks for exactly these
/// two outcomes (an operational record, not a state machine).
enum ToolInvocationStatus {
  SUCCESS
  FAILURE
}

/// `ApprovalRequest.status` (Phase 8, Sections 27/28/31). A new request is
/// always `PENDING` -- the only state `ApprovalWorkflow` itself creates it
/// in, before that workflow ever runs. `APPROVED`/`DENIED` are set by the
/// workflow's own re-evaluation Activity once a human `decide`s (`DENIED`
/// also covers the case where re-evaluation itself fails the approved
/// decision -- see docs/approvals.md's "why DENIED, not a third failure
/// state" note). `EXPIRED` is set by the workflow's own timeout Activity
/// when nobody decides before `expiresAt` -- never by anything polling or
/// reading this row.
enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

/// `ApprovalDecision.decision` -- a human's raw input to `ApprovalWorkflow`
/// (via its `decide` signal), recorded verbatim before any re-evaluation
/// happens. Note this is distinct from `ApprovalRequest.status`: an
/// `APPROVE` decision can still produce a `DENIED` request status if
/// re-evaluation at approval time no longer supports it (Section 27 -- see
/// `ApprovalStatus`'s doc comment).
enum ApprovalDecisionType {
  APPROVE
  DENY
}

/// A pending (or resolved) human-approval gate for one specific
/// `REQUIRE_APPROVAL` decision from `AuthorizationService`'s pipeline
/// (Phase 8, Sections 27/28/31 -- see docs/approvals.md). Created by `POST
/// /agent/v1/tools/invoke` the moment that pipeline yields
/// `REQUIRE_APPROVAL`, in the same call that starts the `ApprovalWorkflow`
/// this row's `temporalWorkflowId` names -- no tool call is ever attempted
/// at this point (Section 80's "pending action cannot execute before
/// approval" invariant).
///
/// `toolId`/`actionId`/`resource`/`params` are the *exact* values from the
/// original `POST /agent/v1/tools/invoke` request that triggered this
/// approval -- never re-derived or re-typed later. `params` in particular
/// is what `AuthorizationGrant.parameterHash` (once issued) binds to: the
/// agent's eventual retried request must match these exact values byte for
/// byte (after canonicalization -- see `src/approvals/parameter-hash.util.ts`)
/// or its grant is rejected (Section 80's parameter-binding invariant).
///
/// `policyVersionId` is nullable: a `REQUIRE_APPROVAL` decision can come
/// from a matched policy rule (`policyVersionId` set, to the version whose
/// rule matched) *or* purely from `RiskEngine`'s score exceeding
/// `task.riskCeiling` with no policy rule having matched at all -- see
/// `AuthorizationService`'s `risk_ceiling_exceeded` reason, which leaves no
/// version to record.
model ApprovalRequest {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  toolId   String
  actionId String
  resource String
  /// The exact `params` submitted to `POST /agent/v1/tools/invoke` -- see
  /// model doc comment for why this must never be re-derived.
  params Json

  /// The `RiskEngine.finalRiskScore` (0-100) that was part of why this
  /// request required approval -- carried here (rather than only in
  /// structured logs) so a human decision-maker and the eventual
  /// `AuthorizationGrant` can both see exactly what was being approved.
  riskScore Int

  /// The published `PolicyVersion` whose rule produced this
  /// `REQUIRE_APPROVAL` decision -- null when the decision came purely
  /// from `RiskEngine`'s score exceeding `task.riskCeiling` with no policy
  /// rule matching at all. See model doc comment.
  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])

  status ApprovalStatus @default(PENDING)

  requestedAt DateTime @default(now())
  /// This request's own timeout -- `ApprovalWorkflow`'s `decide` signal
  /// wait races against this exact instant (Temporal `sleep`, not a cron
  /// job polling this column). Nobody deciding before this passes ->
  /// `status = EXPIRED`, and no `AuthorizationGrant` is ever issuable for
  /// this request again (see `APPROVAL_REQUEST_TTL_MS`,
  /// `src/approvals/approvals.config.ts` -- 30 minutes by default).
  expiresAt DateTime

  /// The `ApprovalWorkflow` run this request is bound to 1:1 -- what
  /// `POST /approvals/:id/decide` signals and what this row's own
  /// `status`/`AuthorizationGrant` are ultimately written by (from inside
  /// that workflow's own Activities, never directly by the decide/poll
  /// HTTP handlers themselves).
  temporalWorkflowId String @unique

  /// 1:many even though this phase only ever produces one row per request
  /// (decision #33: one approver) -- this is what lets a future N-of-M
  /// approval chain be added without a schema migration; N-of-M logic
  /// itself is out of scope this phase (see docs/approvals.md).
  decisions ApprovalDecision[]

  /// Set only when this request's outcome was `APPROVED` and
  /// re-evaluation at approval time still supported it -- 1:1 (a request
  /// produces at most one grant, ever; see `AuthorizationGrant`'s own doc
  /// comment for why a *replay* of an already-consumed grant is rejected
  /// rather than a new one being issued).
  grant AuthorizationGrant?

  createdAt DateTime @default(now())

  @@map("approval_requests")
}

/// One human's raw decision on an `ApprovalRequest` (Phase 8, decision #33:
/// exactly one approver decides, this phase) -- written by
/// `ApprovalWorkflow`'s own re-evaluation Activity after processing the
/// `decide` signal `POST /approvals/:id/decide` sends, never written
/// directly by that HTTP handler itself (workflow code has no I/O of its
/// own -- Section 28 -- but the *Activity* it invokes does the actual
/// write, and is the only thing that ever does). Modeled 1:many against
/// `ApprovalRequest` (see that model's own doc comment) even though this
/// phase only ever produces one row per request.
model ApprovalDecision {
  id String @id @default(uuid())

  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id])

  approverId String
  approver   UserProfile @relation(fields: [approverId], references: [id])

  decision ApprovalDecisionType
  reason   String?

  decidedAt DateTime @default(now())

  @@map("approval_decisions")
}

/// A short-lived, signed, single-use, exactly parameter-bound grant of
/// authority to execute one specific pending tool action (Phase 8, Section
/// 31 -- see docs/approvals.md for the full grant-token format and how
/// `id` doubles as its `jti`). Issued by `ApprovalWorkflow`'s
/// re-evaluation Activity, and only when: the originating
/// `ApprovalRequest`'s task is still `ACTIVE`/unexpired/under its
/// execution limit, its agent is still `ACTIVE`, and a fresh
/// `PolicyEngine`/`RiskEngine` evaluation (re-run at *this* moment, never
/// trusting the original, possibly-stale decision -- Section 27) still
/// does not deny the action outright. At most one `AuthorizationGrant` is
/// ever created per `ApprovalRequest` (`approvalRequestId` is `@unique`) --
/// there is no "issue another grant for the same request" path anywhere in
/// this codebase; a consumed, expired, or otherwise-invalid grant is
/// simply rejected on retry (Section 80's approval-replay invariant),
/// never silently re-issued.
///
/// `parameterHash` binds this grant to the *exact* `taskId`/`toolId`/
/// `actionId`/`resource`/`params` of the originating `ApprovalRequest` --
/// `POST /agent/v1/tools/invoke`'s retried request (with `grantToken` set)
/// must recompute an identical hash from its own body or the grant is
/// rejected, even if every other field matches (Section 80's
/// parameter-binding invariant -- see
/// `src/approvals/parameter-hash.util.ts`).
///
/// `consumedAt` enforces single-use: `POST /agent/v1/tools/invoke` sets it
/// via a conditional `UPDATE ... WHERE consumedAt IS NULL` (the same
/// race-closing pattern `AuthorizationService.incrementExecutionCount`
/// already uses for `Task.executionCount`) the moment a valid grant is
/// actually used to reach `CredentialBrokerService.invoke` -- a second use
/// of the same token, concurrent or sequential, always loses that race and
/// is denied. `revokedAt` is unused this phase (kill-switch-driven grant
/// revocation is a dedicated later phase) -- the column exists now purely
/// so that phase needs no migration.
model AuthorizationGrant {
  id String @id @default(uuid())

  approvalRequestId String          @unique
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id])

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  toolId   String
  actionId String
  resource String

  /// sha256 hex of the canonicalized `{ taskId, toolId, actionId, resource,
  /// params }` this grant was issued for -- see model doc comment.
  parameterHash String

  /// The `PolicyVersion` re-evaluation confirmed was still published at
  /// grant-issuance time -- null under the same condition
  /// `ApprovalRequest.policyVersionId` is (see that field's doc comment).
  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])

  /// `RiskEngine.finalRiskScore` as of *re-evaluation* (grant-issuance
  /// time), not necessarily equal to `ApprovalRequest.riskScore` (the
  /// original, possibly-stale score) -- Section 27's "don't assume an
  /// action remains safe because approval happened N minutes ago" made
  /// concrete: this is the score that actually justified issuing this
  /// grant.
  riskScore Int

  issuedAt DateTime @default(now())
  /// Short -- `APPROVAL_GRANT_TTL_MS` (`src/approvals/approvals.config.ts`,
  /// 5 minutes by default): an agent that doesn't retry
  /// `POST /agent/v1/tools/invoke` with this grant soon after `APPROVED`
  /// becomes visible via `GET /agent/v1/approvals/:id` finds it expired
  /// and must go through approval again from scratch (no grant-renewal
  /// path exists).
  expiresAt DateTime

  /// Set the moment this grant is actually used to reach
  /// `CredentialBrokerService.invoke` -- see model doc comment. Null means
  /// unconsumed (still usable, if unexpired).
  consumedAt DateTime?
  /// Unused this phase -- see model doc comment.
  revokedAt DateTime?

  @@map("authorization_grants")
}

/// Phase 9a (Tamper-Evident Audit Chain & Kafka Event Backbone). One
/// immutable, hash-chained record of a single security-relevant decision or
/// action anywhere in the product (Section 46 — enough `data` to
/// reconstruct *why* a decision occurred, not just its outcome). **Append-
/// only**: there is no update/delete endpoint or code path for this model
/// anywhere in the application (retention deletion is Phase 9b's scope, via
/// its own dedicated, auditable workflow — never ad hoc code). Every write
/// goes exclusively through `AuditService.record` (`src/audit/audit.service.ts`),
/// which computes `eventHash` from the canonicalized event content plus the
/// chain's current `previousHash` (see `src/audit/canonical-json.ts`) inside
/// the same transaction that advances `AuditChainState` — see that model's
/// doc comment for how a fork in the chain is prevented across concurrent
/// callers/replicas.
///
/// `sequence` is a plain autoincrement purely for cheap, reliable "walk the
/// chain in the order it was actually written" ordering (`verifyAuditChain`
/// / a future export) — it plays no role in the hash chain itself, which is
/// entirely defined by `previousHash`/`eventHash` linkage and would still be
/// verifiable without it; `createdAt` alone is not a safe substitute since
/// two events recorded within the same millisecond would tie.
model AuditEvent {
  id String @id @default(uuid())

  /// Ordering only — see model doc comment. Never referenced by the hash
  /// computation itself.
  sequence Int @default(autoincrement())

  /// Section 29's event-type catalog (`agent.enrolled`, `task.created`,
  /// `authorization.denied`, ...) — see `src/audit/audit-event-types.ts`.
  eventType String

  /// Groups every event produced by one end-to-end request/workflow run —
  /// reuses the request's `x-correlation-id` (`src/logging/correlation-id.store.ts`)
  /// when one is available (every HTTP-originated event), or a
  /// service-generated UUID for events recorded outside any HTTP request
  /// context (e.g. the separate Temporal worker process, which never
  /// imports `LoggingModule` — see `src/audit/audit.service.ts`).
  correlationId String

  /// `{ type: 'human' | 'agent' | 'system', id: string }` — never a bare
  /// string, so a consumer never has to guess which kind of principal
  /// caused this event. `id` is a `UserProfile.id`, `Agent.id`, or a fixed
  /// system label (e.g. `"system:policy-engine"`), depending on `type`.
  actor Json

  /// When this event was recorded — captured once, in application code,
  /// *before* the hash is computed (never `DateTime.now()`/a DB default,
  /// which would make the hash unreproducible from the row's own stored
  /// fields). Distinct from `createdAt` (the row's insert time) purely as a
  /// hygiene matter; the two are set from the same `Date` in practice.
  timestamp DateTime

  /// The actual decision inputs (Section 46) — e.g. matched policy id/
  /// version, risk score, OpenFGA result, denial reason — never just
  /// "denied". **Never the resolved credential value** for a tool
  /// invocation event (a hard rule — see `src/audit/audit-event-types.ts`
  /// and `test/audit-credential-secrecy.e2e-spec.ts`, which greps the
  /// actual stored row).
  data Json

  /// This tenant's previous `AuditEvent.eventHash` at the moment this event
  /// was appended — `null` only for the very first event in a tenant's
  /// chain. Forms the hash chain together with `eventHash` below; see
  /// `src/audit/canonical-json.ts` and `AuditService.verifyAuditChain`.
  previousHash String?

  /// `sha256(canonicalize({ id, eventType, correlationId, actor, timestamp,
  /// data, previousHash }))` — see `src/audit/canonical-json.ts` for why
  /// this uses an explicit recursive-key-sort canonicalization rather than
  /// relying on `JSON.stringify`'s key-insertion-order behavior (a
  /// dependency a future refactor of how this object is constructed could
  /// silently break without ever touching this file).
  eventHash String

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([correlationId])
  @@map("audit_events")
}

/// Singleton bookkeeping row (Section 46/47) so appending the next
/// `AuditEvent` never requires scanning the whole table for its tail. Fixed,
/// known `id` (`"singleton"` — `AuditService.SINGLETON_ID`) rather than a
/// `WHERE`-unique-constraint-on-a-boolean trick, since a tenant database
/// only ever has exactly one chain (Phase 2's per-tenant database isolation
/// already gives this row tenant scoping for free — see
/// docs/tenant-isolation.md).
///
/// `AuditService.record` reads this row with `SELECT ... FOR UPDATE` inside
/// the same transaction that inserts the new `AuditEvent` and updates this
/// row — a real Postgres row-level lock, not an in-memory mutex, so two
/// concurrent `record` calls (even across separate API replicas, which an
/// in-memory mutex could never coordinate) are serialized by Postgres
/// itself: the second caller's `FOR UPDATE` blocks until the first
/// transaction commits, so it always reads the first call's freshly-written
/// `latestEventHash` as its own `previousHash` — the chain can never fork.
model AuditChainState {
  /// Always `"singleton"` — see model doc comment.
  id String @id

  /// `AuditEvent.id`/`AuditEvent.eventHash` of the most recently appended
  /// event — both `null` only before this tenant's very first `AuditEvent`
  /// has ever been recorded.
  latestEventId   String?
  latestEventHash String?

  /// Total events ever recorded — redundant with `AuditEvent`'s row count,
  /// kept here anyway so a caller never has to `COUNT(*)` the append-only
  /// table just to answer "how many audit events exist" (a query
  /// `AuditService.record` already has to touch this row for the lock,
  /// per the model's own doc comment).
  eventCount Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("audit_chain_state")
}
