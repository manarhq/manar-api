// Control DB schema — provisioning/routing metadata only.
//
// No business/security data (agents, tasks, policies, audit, etc.) is ever
// stored here — enforced by review, not by a runtime check, since Prisma
// schemas are compile-time-fixed. See docs/tenant-isolation.md.
//
// The datasource block intentionally has no `url` — Prisma 7 driver
// adapters resolve the connection at runtime (see
// src/database/control-prisma.service.ts), and the CLI/migration-time
// connection is resolved by prisma/control.config.ts instead.
datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/control-client"
  // This project is CommonJS (no "type": "module" in package.json, Nest
  // built via ts-loader/tsc to CJS). Prisma 7's client generator defaults
  // to ESM output, which would break under Nest's CJS setup.
  moduleFormat = "cjs"
}

enum TenantStatus {
  /// Waiting in the provisioning queue (capacity headroom was low at sign-up). Treated like
  /// PROVISIONING everywhere: not ACTIVE, so every guard refuses it.
  QUEUED
  /// Gave up after repeated provisioning failures; `workspaces:retry` puts it back in the queue.
  FAILED
  PROVISIONING
  ACTIVE
  SUSPENDED
  DEPROVISIONING
  DELETED
}

/// Data-residency posture per Section 54 of the master prompt. Captured
/// from day one even though only UAE is exercised in this phase, so later
/// phases never need a destructive schema change to add residency
/// awareness.
enum TenantKind {
  PERSONAL
  COMPANY
  SAMPLE
}

enum MembershipStatus {
  ACTIVE
  PENDING
  REMOVED
}

/// Same eight names as `Role` in tenant.prisma and `ROLES` in src/auth/roles.ts.
enum MembershipRole {
  TENANT_OWNER
  SECURITY_ADMIN
  AI_GOVERNANCE_MANAGER
  SOC_OPERATOR
  APPROVER
  AUDITOR
  DEVELOPER
  READ_ONLY
}

enum TenantResidency {
  UAE
  CUSTOM_REGION
  AIR_GAPPED
}

enum SecretKind {
  DATABASE_CREDENTIAL
  /// A tenant realm's `manar-api` confidential client secret (Phase 3),
  /// generated by Keycloak at realm-provisioning time. Not needed for JWT
  /// signature verification (that only needs the realm's public JWKS) —
  /// captured now because Phase 11's login redirect flow will need it, and
  /// Keycloak only returns/generates it once at client-creation time.
  KEYCLOAK_CLIENT_SECRET
}

/// ENV is `TenantDatabaseManager`'s only implementation this phase (see
/// EnvSecretProvider) — it names an env var holding a value that's the
/// *same* across every tenant (the shared base Postgres URL).
/// OPENBAO is reserved for Phase 4/17's OpenBao-backed secret provider —
/// listed here now so the enum never needs a destructive migration when
/// that swap-in lands.
/// CONTROL_DB (Phase 3) is for secrets that are genuinely different per
/// tenant and only exist once that tenant is provisioned (e.g. a realm's
/// generated client secret) — an env var can't name a value that doesn't
/// exist yet. `reference` holds the value directly for this provider. This
/// is a known, documented limitation (plaintext at rest, same trust
/// boundary as the rest of the control DB's provisioning metadata) that
/// Phase 4/17's OpenBao provider replaces for anything requiring
/// encryption at rest — see docs/human-auth.md.
enum SecretProvider {
  ENV
  OPENBAO
  CONTROL_DB
}

model Tenant {
  id   String @id @default(uuid())
  slug String @unique
  name String

  status TenantStatus @default(PROVISIONING)

  /// Existing (pre-launch) tenants are organisations, so COMPANY is the default.
  kind              TenantKind @default(COMPANY)
  /// PERSONAL: the Keycloak `sub` that owns it (one per subject, partial unique index in the migration).
  ownerSubject      String?
  /// The issuer of `ownerSubject`: a `sub` is only unique within one issuer.
  ownerIssuer       String?
  /// Provisioning retries: failed attempts so far, and when the queue may try again.
  provisionAttempts Int        @default(0)
  nextProvisionAt   DateTime?
  /// COMPANY: the Entra tenant id (`tid`) it was created for (one per tid, partial unique index).
  entraTenantId     String?

  residency              TenantResidency @default(UAE)
  allowExternalAi        Boolean         @default(false)
  allowOutboundTelemetry Boolean         @default(false)
  allowCloudStorage      Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Phase 3 (Human Authentication): the Keycloak realm provisioned for
  /// this tenant. Null until `TenantProvisioningService` completes the
  /// Keycloak leg of provisioning (see "Known limitations" in
  /// docs/human-auth.md for what happens if that leg fails after the DB
  /// leg already succeeded).
  keycloakRealm String? @unique

  /// The exact issuer URL Keycloak stamps into this realm's tokens' `iss`
  /// claim (e.g. `http://localhost:8081/realms/acme`). This is the
  /// allow-list key `JwtAuthGuard` looks up an unverified token's `iss`
  /// claim against — never trusted from the token itself for anything
  /// beyond that lookup (see docs/human-auth.md).
  keycloakIssuerUrl String? @unique

  /// `clientId` of the confidential client created in this tenant's realm
  /// for manar-api (not the Keycloak-internal client UUID).
  keycloakClientId String?

  databaseBinding  TenantDatabaseBinding?
  secretReferences SecretReference[]
  catalog          TenantCatalog?
  edgePeers        EdgePeer[]
  memberships      Membership[]
  entitlement      TenantEntitlement?
  installCodes     InstallCode[]

  @@map("tenants")
}

model TenantDatabaseBinding {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  databaseName String @unique

  secretReferenceId String          @unique
  secretReference   SecretReference @relation(fields: [secretReferenceId], references: [id])

  /// Reuses TenantStatus, scoped to database-provisioning progress rather
  /// than tenant lifecycle — the two are related but not always identical
  /// (e.g. a tenant can be ACTIVE while its binding is still PROVISIONING
  /// for a brief window during `provisionTenant`).
  provisioningStatus TenantStatus @default(PROVISIONING)

  provisionedAt        DateTime?
  lastMigratedAt       DateTime?
  lastMigrationVersion String?

  /// Host/port/engine-version notes and similar deployment-topology
  /// metadata. Folded in here rather than a separate 1:1 model per
  /// Section 70's normalization guidance (avoid a model that only ever has
  /// one row per binding).
  deploymentMetadata Json?

  @@map("tenant_database_bindings")
}

model SecretReference {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  kind     SecretKind     @default(DATABASE_CREDENTIAL)
  provider SecretProvider @default(ENV)

  /// Opaque string interpreted per `provider`. For ENV, this is the name
  /// of the environment variable holding the base Postgres connection URL
  /// (see EnvSecretProvider) — never the credential value itself.
  reference String

  createdAt DateTime @default(now())

  databaseBinding TenantDatabaseBinding?

  @@map("secret_references")
}

/// Kill-switch phase (Section 32): the one, genuinely cross-tenant kill
/// switch — "platform/deployment" scope. Deliberately NOT tenant data (see
/// the four tenant-scoped `KillSwitch` rows in `prisma/tenant.prisma`
/// instead): it must remain checkable even for a tenant whose own
/// control-DB row or database might itself be compromised, and it belongs
/// in the control DB precisely because Section 10/11 already established
/// the control DB as the one place cross-tenant operational metadata like
/// this lives, distinct from tenant business/security data — see
/// docs/tenant-isolation.md.
///
/// Singleton row (fixed, known `id` — the same `"singleton"` convention
/// `AuditChainState` in `prisma/tenant.prisma` already uses, since a
/// deployment only ever has exactly one platform-wide switch), toggled in
/// place by activate/deactivate rather than appended as history — mirrors
/// tenant DB's own `KillSwitch` model's activatedAt/deactivatedAt pair
/// shape. `activatedBy`/`deactivatedBy` are free text (not a FK): the
/// control DB has no `UserProfile` table at all (that's tenant data — see
/// `RoleBinding.grantedBy`'s doc comment for the same
/// free-text-provenance-across-a-trust-boundary precedent) — see
/// `src/kill-switches/platform-operator.guard.ts` for who is actually
/// allowed to flip this switch and why that is deliberately NOT gated by
/// any tenant's own RBAC role.
model PlatformKillSwitch {
  /// Always `"singleton"` — see model doc comment.
  id String @id

  active Boolean @default(false)
  reason String?

  activatedBy String?
  activatedAt DateTime?

  deactivatedBy String?
  deactivatedAt DateTime?

  updatedAt DateTime @updatedAt

  @@map("platform_kill_switches")
}

/// What Manar staff turned on for this tenant through manar-fleet (src/platform/catalog.*):
/// feature flags, enabled packs and the LLM route. Read on every gated request; a read failure
/// or a malformed row denies. No row means the tenant is unmanaged: every feature keeps its
/// pre-catalog default (on), no pack is enabled, and the LLM proxy uses the deployment's model.
model TenantCatalog {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `{ assistant?, watcher?, packs?, llm_proxy? }` booleans; a missing key keeps the default.
  features  Json     @default("{}")
  /// `{ id, version, enabled }[]`, one entry per pack staff have decided on.
  packs     Json     @default("[]")
  /// `{ provider, model, uaeResidency, monthlyTokenQuota }` or null for the deployment default.
  model     Json?
  /// The platform caller (manar-fleet client id) that last wrote the row.
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_catalogs")
}

enum EdgePeerState {
  active
  cut
}

/// docs/edge.md: one WireGuard peer per agent enrolled on the Manar edge. Platform level because the
/// gateway serves every tenant. A projection only: the tenant database stays the source of truth
/// for the agent's state and allow-list, and `EdgePeerService` recomputes this row from it.
/// Rows are never deleted while the tenant exists, so an address is never reused while a row
/// holds it.
model EdgePeer {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantSlug   String
  agentId      String
  agentSlug    String
  /// WireGuard public key (base64, 32 bytes). The private key never leaves the host.
  publicKey    String        @unique
  /// Overlay address, `a.b.c.d/32`.
  address      String        @unique
  state        EdgePeerState
  /// Why the peer is cut (the first stop condition found), null when active.
  cutReason    String?
  allowHosts   String[]      @default([])
  /// `EdgeState.version` when this row last changed.
  version      Int
  /// Refresh tickets: a refresher takes `refreshSeq + 1` before it reads the tenant database and
  /// writes only if no fresher read was applied (`appliedSeq`), so a stale read never overwrites a
  /// newer one.
  refreshSeq   Int           @default(0)
  appliedSeq   Int           @default(0)
  /// Expiry of the agent's newest unrevoked certificate as last read; the next recompute is
  /// scheduled at the earliest one.
  certNotAfter DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, agentId])
  @@index([version])
  @@map("edge_peers")
}

/// Singleton (`id = "singleton"`): the global, monotonic edge peer version. Every change to any peer
/// takes this row's lock and bumps it in the same transaction, so versions commit in order.
model EdgeState {
  id                  String    @id
  version             Int       @default(0)
  /// The replica holding this lease runs the periodic reconcile.
  reconcileLeaseUntil DateTime?

  @@map("edge_state")
}

/// The newest audit SEAL (signed checkpoint) of each tenant, kept outside the
/// tenant's own database. The worker refuses to seal, and verification
/// fails, when the tenant database no longer holds this SEAL unchanged, so
/// deleting SEALs and rewriting history can't be re-signed by the worker.
/// Also the incremental-verification watermark: the last SEAL verified and
/// the partition heads it covered.
model AuditSealMark {
  tenantId      String   @id
  sealSeq       BigInt
  sealHash      String
  verifiedSeq   BigInt?
  verifiedHash  String?
  verifiedHeads Json?
  updatedAt     DateTime @updatedAt

  @@map("audit_seal_marks")
}

/// Who may use which workspace, and as what (spec 4.1). The only source of roles: the token's
/// `realm_access` is never read. `subject` is the Keycloak `sub`, never an email, so two sign-in
/// methods with the same email are two separate subjects with separate memberships.
model Membership {
  id       String @id @default(uuid())
  /// Issuer of the token `subject` came from. A `sub` is only unique within an issuer, so every
  /// lookup filters on both.
  issuer   String
  subject  String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The highest role held; `extraRoles` holds the rest (a user may hold several roles).
  role       MembershipRole
  extraRoles MembershipRole[] @default([])
  status     MembershipStatus @default(PENDING)

  /// Display hints copied from the token at request time. Never used for access decisions.
  email       String?
  displayName String?
  grantedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, subject, tenantId])
  @@index([tenantId, status])
  @@index([issuer, subject])
  @@map("memberships")
}

/// Weekly AI report card (features track). One row per tenant and week, computed by the worker
/// on Sunday night or on demand. Totals only: counts and a 7-day series, never names or content.
model WeeklyReportCard {
  tenantId   String
  weekEnd    DateTime
  data       Json
  computedAt DateTime @default(now())

  @@id([tenantId, weekEnd])
  @@map("weekly_report_cards")
}

/// A public, revocable share of a report card. `id` is 24 random bytes in base64url (192 bits).
/// `totals` is the snapshot taken at share time; the public endpoint reads only this row.
model ReportShare {
  id        String    @id
  tenantId  String
  totals    Json
  /// Insight track: a redacted agent session (`SharedSession`), when the link shares one session
  /// instead of the weekly card. Stored as a snapshot; never read back from the tenant database.
  session   Json?
  createdBy String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([tenantId])
  @@map("report_shares")
}

enum EntitlementPlan {
  free
  pro
  company_trial
  company
  enterprise
}

enum EntitlementStatus {
  active
  past_due
  /// Lapsed company trial or unpaid: reads and export only (EntitlementsService.get derives this
  /// for an expired trial; Stripe events set it for non-payment).
  read_only
}

/// Plan, limits source and Stripe ids per tenant (docs/billing.md). No row means the free plan.
/// Limits are never stored: they come from the plan table in src/billing/plans.ts so a price
/// change ships with code, not a data migration.
model TenantEntitlement {
  tenantId             String            @id
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 EntitlementPlan   @default(free)
  status               EntitlementStatus @default(active)
  trialEndsAt          DateTime?
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  /// `month` or `year` for Pro; null otherwise.
  billingInterval      String?
  /// Newest Stripe event applied; older subscription events are skipped.
  lastStripeEventAt    DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("tenant_entitlements")
}

/// Stripe event ids already applied (webhook idempotency). Pruned by age, never read for anything else.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}

/// The short code of the "Add device" one-liner (`/i/<code>`) -> the tenant and the install key it
/// stands for, so the public routes can find the tenant without a token. The code itself is the
/// install key's secret (the tenant-side key row is its SHA-256), so only the hash is kept here.
/// Valid for one hour; the row is deleted when the code is used, when its key is revoked, and when
/// it expires.
model InstallCode {
  id           String   @id @default(uuid())
  /// SHA-256 (hex) of the upper-case 10-character code.
  codeHash     String   @unique
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `InstallKey.id` in the tenant database.
  installKeyId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@index([installKeyId])
  @@map("install_codes")
}

/// Browser Web Push subscription of one person (spec 4.6). One row per browser endpoint. Pruned when
/// the push service answers 404 or 410.
model PushSubscription {
  id        String   @id @default(uuid())
  /// Keycloak subject.
  subject   String
  tenantId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([subject])
  @@map("push_subscriptions")
}
