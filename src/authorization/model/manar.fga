# Manar OpenFGA authorization model (Phase 5: Tasks, Delegation & OpenFGA).
#
# See docs/authorization-model.md for the full modeling rationale. Summary:
#
#   - Permission flows through `task`, never attached to `agent` directly
#     (Section 18 — agents start with effectively zero permanent authority).
#     `grant#can_use` computes to "whoever is the task's assigned_agent" via
#     `assigned_agent from of_task` — an agent that stops being a task's
#     assigned_agent (or was never it) loses `can_use` automatically, with
#     no tuple ever written naming the agent directly on the grant.
#
#   - A `grant` is a synthetic per-(task, tool_action, resource-or-"*")
#     object — one tuple written per entry in the cross-join of a task's
#     `allowedToolActions` x `allowedResourceSelectors` (see
#     src/authorization/grant-triples.ts). `AuthorizationService` computes
#     the same deterministic object ID the writer used
#     (src/authorization/openfga-object-id.util.ts) and calls `check()`
#     against it directly — no ListObjects/expand scan needed.
#
#   - `forbidden_agent` is a directly-assignable relation (required by
#     OpenFGA's `but not` exclusion operator — the excluded side cannot
#     itself be a computed/`from` relation) written onto every grant object
#     whose (toolId, actionId) appears in a task's `forbiddenActions`. This
#     mirrors the JSON column's "explicit denies win over allows" rule
#     *inside* the model itself (not just as an app-layer short-circuit
#     before OpenFGA is ever called) — defense in depth, so OpenFGA's own
#     check() independently enforces the same deny even if the app-layer
#     short-circuit were ever bypassed by a bug.
#
#   - `tenant`/`tool`/`tool_action`/`resource` are wired into the graph for
#     real (tuples written at grant-creation time — see
#     TaskGrantSyncService) even though `can_use`'s own computation only
#     strictly needs `of_task` + `forbidden_agent`. This keeps the model an
#     actual Zanzibar-style relationship graph of the domain, not a
#     decorative type list satisfying the spec's naming requirement.
#
#   - Ancestor-chain walking (Section 20's ancestor task must be
#     ACTIVE/unexpired/under its own execution limit) and expiry/
#     maxExecutions are *not* represented here at all — those are real-time
#     checks AuthorizationService runs directly against Postgres task rows
#     (steps 2-3 of the authorize pipeline), deliberately never mirrored
#     into OpenFGA. This is what makes revoking a parent task immediately
#     invalidate every descendant's authorization with zero cascade writes:
#     OpenFGA has no notion of task status/expiry to go stale in the first
#     place.
model
  schema 1.1

type user

type tenant
  relations
    define member: [user]

type agent
  relations
    define tenant: [tenant]

type tool
  relations
    define tenant: [tenant]

type tool_action
  relations
    define tool: [tool]

type resource
  relations
    define tool: [tool]

type task
  relations
    define tenant: [tenant]
    define assigned_agent: [agent]

type grant
  relations
    define of_task: [task]
    define tool_action: [tool_action]
    define resource: [resource]
    define forbidden_agent: [agent]
    define can_use: (assigned_agent from of_task) but not forbidden_agent

# ---------------------------------------------------------------------------------------------
# Staff RBAC (DESK Phase 1, docs/authorization-model.md "Staff"). Postgres is the source of
# truth (staff_roles, staff_role_assignments, staff_groups); these tuples are its projection.
#   - A role instance is one `role` object per (role, scope): `role:<roleId>~platform~manar`.
#     Its permissions are tuples `platform:manar#<permission>@role:<instance>#assignee`.
#   - A staff member or a group holds the role through `assignee`. Elevations and timed grants
#     carry the `within_window` condition, so their power ends at `expires_at` at check time,
#     with no job involved; every staff check passes `current_time`.
# ---------------------------------------------------------------------------------------------
type staff

type group
  relations
    define member: [staff, group#member]

type role
  relations
    define assignee: [staff, staff with within_window, group#member]

type platform
  relations
    define people_search: [role#assignee]
    define orgs_search: [role#assignee]
    define people_view: [role#assignee]
    define orgs_view: [role#assignee]
    define people_reveal_pii: [role#assignee]
    define people_sessions_revoke: [role#assignee]
    define notes_write: [role#assignee]
    define tags_write: [role#assignee]
    define restrict_warn: [role#assignee]
    define restrict_suspend_propose: [role#assignee]
    define restrict_suspend: [role#assignee]
    define restrict_lift: [role#assignee]
    define restrict_ban: [role#assignee]
    define restrict_unban_propose: [role#assignee]
    define restrict_unban_approve: [role#assignee]
    define restrict_immediate_approve: [role#assignee]
    define appeals_review: [role#assignee]
    define matches_review: [role#assignee]
    define staff_view: [role#assignee]
    define staff_manage: [role#assignee]
    define staff_owner_grant_propose: [role#assignee]
    define staff_owner_grant_approve: [role#assignee]
    define staff_roles_manage: [role#assignee]
    define staff_audit_view: [role#assignee]
    define errors_view: [role#assignee]

condition within_window(current_time: timestamp, expires_at: timestamp) {
  current_time < expires_at
}
