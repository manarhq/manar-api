{
  "name": "manar-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "nest build && pnpm --filter @manar/sdk-node build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit && pnpm --filter @manar/sdk-node typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./test/vitest.config.e2e.mts",
    "prepare": "husky",
    "postinstall": "pnpm db:generate",
    "infra:up": "docker compose -f deploy/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f deploy/docker-compose.yml down",
    "infra:openbao-init": "node deploy/openbao-init.mjs",
    "fga:test": "docker run --rm -v $PWD/src/authorization/model:/model openfga/cli:latest model test --tests /model/manar.fga.yaml",
    "db:generate": "prisma generate --schema prisma/control.prisma --config prisma/control.config.ts && prisma generate --schema prisma/tenant.prisma --config prisma/tenant.config.ts",
    "db:migrate:control": "prisma migrate dev --schema prisma/control.prisma --config prisma/control.config.ts",
    "db:migrate:control:deploy": "prisma migrate deploy --schema prisma/control.prisma --config prisma/control.config.ts",
    "manar": "nest build && node dist/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@openfga/sdk": "^0.9.7",
    "@openfga/syntax-transformer": "^0.2.2",
    "@peculiar/x509": "^2.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "jose": "^6.2.9",
    "js-yaml": "^5.3.0",
    "nest-commander": "^3.20.1",
    "nest-winston": "^1.10.2",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@manar/sdk-node": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  }
}
