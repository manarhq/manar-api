{
  "name": "manar-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "nest build && pnpm --filter @manar/sdk-node build && pnpm --filter @manar-ai/grpc-client build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "worker": "nest start --entryFile worker.main",
    "worker:dev": "nest start --watch --entryFile worker.main",
    "worker:prod": "node dist/worker.main",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "typecheck": "pnpm packages:build && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "packages:build": "pnpm --filter @manar-ai/grpc-client build && pnpm --filter @manar/sdk-node build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./test/vitest.config.e2e.mts",
    "prepare": "husky",
    "postinstall": "pnpm db:generate",
    "infra:up": "mkdir -p -m 700 ${MANAR_OPENBAO_HOME:-$HOME/.manar-openbao} && docker compose -f deploy/docker-compose.yml up -d --wait",
    "infra:up:ai": "mkdir -p -m 700 ${MANAR_OPENBAO_HOME:-$HOME/.manar-openbao} && MANAR_API_OLLAMA_HOST=${MANAR_API_OLLAMA_HOST:-http://ollama:11434} MANAR_API_OLLAMA_TIMEOUT_SECONDS=${MANAR_API_OLLAMA_TIMEOUT_SECONDS:-180} docker compose -f deploy/docker-compose.yml --profile ai up -d --wait && docker exec manar-ollama ollama pull qwen3:8b && docker exec manar-ollama ollama pull qwen3-embedding:0.6b",
    "infra:down": "docker compose -f deploy/docker-compose.yml --profile ai down",
    "infra:openbao-init": "node deploy/openbao-init.mjs",
    "fga:test": "docker run --rm -v $PWD/src/authorization/model:/model openfga/cli:latest model test --tests /model/manar.fga.yaml",
    "db:generate": "prisma generate --schema prisma/control.prisma --config prisma/control.config.ts && prisma generate --schema prisma/tenant.prisma --config prisma/tenant.config.ts",
    "db:migrate:control": "prisma migrate dev --schema prisma/control.prisma --config prisma/control.config.ts",
    "db:migrate:control:deploy": "prisma migrate deploy --schema prisma/control.prisma --config prisma/control.config.ts",
    "manar": "nest build && node dist/cli.js",
    "demo:agent": "ts-node --project scripts/tsconfig.json scripts/demo-agent.ts"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.10.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.3",
    "@grpc/grpc-js": "^1.14.5",
    "@manar-ai/grpc-client": "workspace:*",
    "@manar/sdk-node": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.2.4",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@openfga/sdk": "^0.9.7",
    "@openfga/syntax-transformer": "^0.2.2",
    "@opensearch-project/opensearch": "^3.6.0",
    "@peculiar/x509": "^2.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "1.20.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "jose": "^6.2.9",
    "js-yaml": "^5.3.0",
    "ldapts": "9.2.0",
    "nest-commander": "^3.20.1",
    "nest-winston": "^1.10.2",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "prom-client": "15.1.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@temporalio/testing": "1.25.0",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "ldapjs": "3.0.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  }
}
