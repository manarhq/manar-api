# Copy to .env for local development. See docs/tenant-isolation.md for how
# CONTROL_DATABASE_URL and TENANT_DB_BASE_URL are used.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Control DB: provisioning/routing metadata only (Tenant, TenantDatabaseBinding,
# SecretReference). Matches deploy/docker-compose.yml's default credentials.
CONTROL_DATABASE_URL=postgresql://manar:manar@localhost:55432/manar_control

# Base connection URL for tenant databases. TenantDatabaseManager substitutes
# each tenant's databaseName into this URL's path — the database name in
# this URL itself is a placeholder and never connected to directly.
TENANT_DB_BASE_URL=postgresql://manar:manar@localhost:55432/postgres

# Keycloak (Phase 3: Human Authentication). Matches deploy/docker-compose.yml's
# default local dev instance and its bootstrap admin credentials. See
# docs/human-auth.md.
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_ID=manar-api

# Human sign-in trust (spec 4.1). Comma-separated issuer URLs this API accepts tokens from:
# the shared hosted realm and, for a customer-hosted install, that install's realm. Legacy
# per-tenant realms recorded in the control DB are accepted too (and bound to their tenant).
AUTH_ISSUERS=http://localhost:8081/realms/manar
# Hosted workspaces: company trial start (Entra admins), provisioning queue and capacity.
# COMPANY_TRIAL_ENABLED=true
# WORKSPACE_PROVISION_CONCURRENCY=4
# WORKSPACE_MAX_TENANTS=5000
# WORKSPACE_QUEUE_AT_RATIO=0.95
# WORKSPACE_QUEUE_DRAIN_MS=5000
# TENANT_MIGRATE_CONCURRENCY=4
# Phase 14 security cleanup 2: manar-web's own base URL -- TenantProvisioningService
# registers <MANAR_WEB_BASE_URL>/api/auth/callback and its origin as the
# tenant's confidential client's redirectUris/webOrigins at provisioning
# time, so manar-web no longer needs standing Keycloak admin credentials
# just to register its own login callback. See keycloak.config.ts.
MANAR_WEB_BASE_URL=http://localhost:3100

# OpenBao (Phase 4: Agent Identity & Enrollment) — PKI signing backend.
# Matches deploy/docker-compose.yml's default local dev instance. Run
# `pnpm infra:openbao-init` once the container is healthy — see
# docs/agent-identity.md.
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=manar-dev-root-token
OPENBAO_PKI_ROOT_PATH=pki
OPENBAO_PKI_INTERMEDIATE_PATH=pki_int
OPENBAO_PKI_AGENT_ROLE=manar-agent
# Phase 7b: KV v2 mount OpenBaoSecretProvider reads Tool.credentialReference
# values from. See docs/tool-gateway.md.
OPENBAO_KV_MOUNT_PATH=secret

# Agent-facing mTLS listener (Phase 4), distinct from PORT above. Cert/key/CA
# files are written by deploy/openbao-init.mjs.
AGENT_MTLS_PORT=3443
AGENT_MTLS_SERVER_CERT_PATH=deploy/openbao/server-cert.pem
AGENT_MTLS_SERVER_KEY_PATH=deploy/openbao/server-key.pem
AGENT_MTLS_CLIENT_CA_PATH=deploy/openbao/ca-chain.pem

# OpenFGA (Phase 5: Tasks, Delegation & OpenFGA) — relationship-based
# authorization engine. Matches deploy/docker-compose.yml's default local
# dev instance. Store/model resolve automatically at boot (list-or-create
# by name, write-a-new-model-version-if-the-DSL-changed) — see
# docs/authorization-model.md. OPENFGA_STORE_ID/OPENFGA_AUTHORIZATION_MODEL_ID
# are optional overrides to pin a specific store/model instead.
OPENFGA_API_URL=http://localhost:8080
# Bound on one OpenFGA check, retries included; past it the decision is a
# recorded DENY enforcement_dependency_unavailable.
OPENFGA_CHECK_TIMEOUT_MS=1000
OPENFGA_STORE_NAME=manar
OPENFGA_MODEL_FILE_PATH=src/authorization/model/manar.fga

# packages/demo-soc-tools (Phase 7a) — used only by
# test/tool-gateway-demo-integration.e2e-spec.ts (the Phase 7a/7b
# integration pass) to reach the real, running demo-soc-tools service
# and to independently re-verify its state; not read by manar-api's own
# app code. Matches deploy/docker-compose.yml's host port mapping and
# DEMO_TOOLS_API_KEY dev default — `pnpm infra:up` brings this service up
# automatically. See docs/tool-gateway.md.
DEMO_SOC_TOOLS_BASE_URL=http://localhost:3101
DEMO_TOOLS_API_KEY=manar-dev-demo-tools-key

# Temporal (Phase 8: Approval Engine) — the durable workflow engine
# ApprovalWorkflow runs on. Matches deploy/docker-compose.yml's default
# local dev instance and its "default" auto-created namespace. Read by both
# the main process (to start/signal workflows) and the separate worker
# process (`pnpm worker` — see src/worker.main.ts). See docs/approvals.md.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=manar-approvals

# Approval grant signing (Phase 8). A short-lived AuthorizationGrant token
# (see docs/approvals.md) is an HS256 JWT signed with this shared secret —
# dev-only default below; a real deployment must override it with a long
# random value known only to the processes that need it (the HTTP app and
# the worker process both sign/verify grants, so both need this exact
# value). APPROVAL_GRANT_TTL_MS: how long an issued grant remains usable
# (default 5 minutes). APPROVAL_REQUEST_TTL_MS: how long an ApprovalRequest
# waits for a human decision before ApprovalWorkflow times it out to
# EXPIRED (default 30 minutes). APPROVAL_DECIDE_RESULT_TIMEOUT_MS (Phase 14
# security cleanup 1): how long POST /approvals/:id/decide waits for
# ApprovalWorkflow's actual resolved outcome before giving up with a 504
# (default 2 minutes) -- see ApprovalsController.decide's doc comment.
APPROVAL_GRANT_SIGNING_SECRET=dev-only-approval-grant-signing-secret-change-me
APPROVAL_GRANT_TTL_MS=300000
APPROVAL_REQUEST_TTL_MS=1800000
APPROVAL_DECIDE_RESULT_TIMEOUT_MS=120000

# Kafka (Phase 9a: Tamper-Evident Audit Chain & Kafka Event Backbone) — the
# domain-event backbone every AuditEvent is also published to. Matches
# deploy/docker-compose.yml's `kafka` service's host-mapped
# PLAINTEXT_HOST listener (every process that reads this config runs on the
# host, never inside the compose network). See docs/audit-chain.md.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=manar-api
KAFKA_AUDIT_TOPIC=manar.audit-events
# TLS and SASL to the brokers (off for the local Compose stack). PLAIN needs KAFKA_SSL=true.
# KAFKA_SSL=true
# KAFKA_SSL_CA_FILE=/etc/manar/tls/kafka-ca.pem
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=manar-api
# KAFKA_SASL_PASSWORD=

# Redis (Phase 9b: SSE live-feed pub/sub fanout). Matches
# deploy/docker-compose.yml's `redis` service. See docs/audit-chain.md.
REDIS_URL=redis://localhost:6379
# Bound on every connect and command of the request-path Redis clients (rate
# limits, idempotency). Past it the agent surface fails closed (503) and the
# human surface's limits fall back to memory.
REDIS_TIMEOUT_MS=1000
# Valkey/Redis ACL user and TLS: use rediss:// for TLS; the CA file needs rediss://.
# REDIS_USERNAME=manar-api
# REDIS_PASSWORD=
# REDIS_TLS_CA_FILE=/etc/manar/tls/valkey-ca.pem

# OpenSearch (Phase 9b: audit-event indexing). Matches
# deploy/docker-compose.yml's `opensearch` service. See docs/audit-chain.md.
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_AUDIT_INDEX=manar-audit-events
# Secured cluster: https node, basic auth (both or neither) and an optional private CA.
# OPENSEARCH_USERNAME=manar-api
# OPENSEARCH_PASSWORD=
# OPENSEARCH_TLS_CA_FILE=/etc/manar/tls/opensearch-ca.pem

# manar-ai's gRPC AnalysisService (Phase 10b: AI Advisory Pipeline
# Integration) — advisory risk/DLP/prompt-injection signals, never an
# authorization decision of its own. Matches deploy/docker-compose.yml's
# `manar-ai` service's host-mapped gRPC port. Plaintext this phase (see
# docs/ai-security-model.md). AiAdvisoryClient splits its timeout/circuit
# breaker into two independent lanes — see that class's doc comment. The
# plain AI_ADVISORY_TIMEOUT_MS/AI_ADVISORY_CIRCUIT_BREAKER_* vars below tune
# the HOT lane only (AnalyzeRisk/AnalyzePromptInjection/AnalyzeDlp — inline
# on the authorization/tool-invocation path).
AI_ADVISORY_GRPC_TARGET=localhost:50051

# Release 2026-11-11 -- mTLS to manar-ai's AnalysisService.
#
# Off by default. manar-ai still binds a plaintext gRPC port when its own
# ENVIRONMENT is local/development/test (logging a warning), which is what
# the `pnpm infra:up` developer stack uses -- so leaving this false keeps
# local development working unchanged.
#
# It REFUSES to bind plaintext at all under staging/production, so any real
# deployment must set this to true and supply all three files together
# (a half-configured client fails at startup, deliberately).
#
# The client certificate's CN or DNS SAN must be `manar-api` (this process)
# or `manar-api-worker` (the Temporal worker) -- manar-ai rejects any other
# identity with PERMISSION_DENIED even when the certificate is CA-issued.
# Both certificates must come from the same internal CA manar-ai loads as
# its client CA; it does not consult the system trust store.
AI_ADVISORY_TLS_ENABLED=false
#AI_ADVISORY_TLS_CA_FILE=/etc/manar/tls/ca.crt
#AI_ADVISORY_TLS_CERT_FILE=/etc/manar/tls/tls.crt
#AI_ADVISORY_TLS_KEY_FILE=/etc/manar/tls/tls.key
AI_ADVISORY_TIMEOUT_MS=2000
AI_ADVISORY_CIRCUIT_BREAKER_THRESHOLD=3
AI_ADVISORY_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# AI_ADVISORY_LONGFORM_* tune the LONG-FORM lane (SummarizeIncident/
# SuggestPolicy/InvestigateAudit — explicit, user-initiated LLM generation,
# off the authorization path). This lane's timeout is deliberately much
# longer than the hot lane's, and its circuit breaker is fully independent
# — a run of slow generations must never suppress inline risk/DLP/
# prompt-injection signals. See AiAdvisoryClient's doc comment.
AI_ADVISORY_LONGFORM_TIMEOUT_MS=30000
AI_ADVISORY_LONGFORM_CIRCUIT_BREAKER_THRESHOLD=3
AI_ADVISORY_LONGFORM_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Phase 12a (Section 54, data residency enforcement) — this side's own
# declaration of which provider manar-ai is CURRENTLY CONFIGURED to use
# (manar-api cannot introspect manar-ai's own AI_PROVIDER over gRPC — see
# AI_ADVISORY_PROVIDER's doc comment in src/ai-advisory/ai-advisory.config.ts).
# Only 'anthropic' is treated as external; keep this in sync with whatever
# manar-ai's own deployment config actually sets, or a tenant's
# allowExternalAi=false will never actually be enforced.
AI_ADVISORY_PROVIDER=ollama

# Gate 0 R5: a tool result flagged as prompt injection with at least this
# confidence (0-1) is withheld from the agent; below it, only the agent's
# risk flag is set.
PROMPT_INJECTION_BLOCK_THRESHOLD=0.8

# Phase 12a (App Hardening & Webhooks) — see docs/security.md.
# Redis-backed rate limiting (decision #76): per-tenant on the human JWT
# surface, per-agent on the mTLS /agent/v1/* surface.
RATE_LIMIT_HUMAN_TTL_MS=60000
RATE_LIMIT_HUMAN_LIMIT=300
RATE_LIMIT_AGENT_TTL_MS=60000
RATE_LIMIT_AGENT_LIMIT=120

# Internal Prometheus listeners (never routed by an ingress); 0 disables.
METRICS_PORT=9464
WORKER_METRICS_PORT=9465

# CORS (Section 99): comma-separated allow-list, or the single literal '*'
# for local development only. resolveCorsOrigin() (src/security/cors.ts)
# REFUSES to boot with a wildcard once NODE_ENV=production — a real
# deployment must set this explicitly.
CORS_ALLOWED_ORIGINS=*

# Webhooks (Section 51) — see docs/security.md's signing-scheme section.
# WEBHOOK_DELIVERY_TASK_QUEUE is a dedicated Temporal task queue, separate
# from TEMPORAL_TASK_QUEUE — see that field's own doc comment,
# src/webhooks/webhooks.config.ts, for why.
WEBHOOK_DELIVERY_TASK_QUEUE=manar-webhooks
WEBHOOK_SIGNATURE_TOLERANCE_MS=300000
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_DELIVERY_MAX_ATTEMPTS=6

# Idempotency-Key support (Section 8) — how long a claimed key's cached
# response stays replayable.
IDEMPOTENCY_KEY_TTL_MS=86400000
# In-progress marker lifetime; store() replaces it with the result. Bounds how
# long a request whose result could not be cached answers 409 on retry.
IDEMPOTENCY_IN_PROGRESS_TTL_MS=60000

# SSRF protection (assertSafeOutboundUrl, src/common/ssrf/) — an explicit,
# operator-controlled exact-hostname exception list to the default "reject
# private/loopback/link-local/metadata-service addresses" policy. Real
# deployments should only list their own known-internal tool hostnames (or
# leave this empty for full strict enforcement) — this repo's own local
# dev/test value below exists purely so this phase's local HTTP test
# fixtures (which necessarily bind to loopback) and Phase 7a's demo tool
# container (accessed as `localhost`) keep working. See
# src/common/ssrf/ssrf.config.ts's doc comment.
SSRF_ALLOWED_HOSTS=127.0.0.1,localhost
# Development only: lets the allow-listed hosts above resolve to loopback.
# Refused at boot with NODE_ENV=production. Link-local/metadata never reachable.
SSRF_ALLOW_LOOPBACK=true

# Kill switches (Section 32) — see docs/kill-switches.md.
# PLATFORM_KILL_SWITCH_OPERATOR_TOKEN gates POST /kill-switches/platform(/deactivate)
# in ADDITION to JwtAuthGuard+RolesGuard (see PlatformOperatorGuard's doc
# comment for why a per-tenant role alone must never be sufficient to flip a
# switch that denies every tenant at once) — a separate, non-tenant-scoped
# operator credential, never distributed through any tenant's Keycloak
# realm/RBAC. Dev-only default below; a real deployment must override it
# with a long random value known only to genuine platform operators.
PLATFORM_KILL_SWITCH_OPERATOR_TOKEN=dev-only-platform-kill-switch-operator-token-change-me

# Tenant OIDC config resolution (Phase 11b Part 1) — gates
# GET /tenants/:slug/oidc-client-secret (see src/tenants/bff-service.guard.ts
# and src/tenants/tenants.controller.ts's doc comment for the full design).
# A narrow, single-purpose shared secret between manar-api and manar-web's
# BFF — never a copy of KEYCLOAK_ADMIN_USERNAME/PASSWORD. Dev-only default
# below; a real deployment must override it with a long random value known
# only to manar-api and manar-web's BFF process.
MANAR_BFF_SERVICE_TOKEN=dev-only-manar-bff-service-token-change-me

# LLM proxy for agents (ADR-0002) — POST /agent/v1/llm/chat/completions.
# Ollama first (the local path); azure_openai needs the endpoint, deployment
# and AZURE_OPENAI_API_KEY set in the environment (never commit a key).
LLM_PROVIDER=ollama
# Whether the default model above runs in the UAE (Ollama always counts as resident: it runs in
# the deployment). A UAE-resident tenant is refused a non-resident model (src/platform/catalog.*).
LLM_DEFAULT_UAE_RESIDENT=false
LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
# LLM_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# LLM_AZURE_OPENAI_DEPLOYMENT=<deployment>
# LLM_AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=
# Core42 Compass, used only by a tenant whose catalog picks it (src/platform/catalog.*).
# LLM_CORE42_BASE_URL=https://<compass-endpoint>/v1
# CORE42_API_KEY=
LLM_TASK_TOKEN_BUDGET=200000
LLM_UPSTREAM_TIMEOUT_MS=180000
# Anthropic Messages format for Claude Code (POST /agent/v1/llm/anthropic/v1/messages, ADR-0002 A2).
# anthropic | azure_foundry | openai_translate | none. Without its key, anthropic/azure_foundry
# answer 404 anthropic_disabled. The key comes from OpenBao kv/prod/llm-anthropic (api_key).
LLM_ANTHROPIC_PROVIDER=anthropic
# LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=
# LLM_AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
# AZURE_FOUNDRY_API_KEY=
# Models served in Anthropic format; another model is refused, and empty turns the endpoint off.
# LLM_ANTHROPIC_MODELS=
# anthropic-beta values forwarded upstream (others are dropped); default in llm-proxy.config.ts.
# LLM_ANTHROPIC_BETAS=
LLM_STREAM_MAX_MS=900000
# Streamed answers: buffer (default; checked whole, then replayed) or incremental (weaker).
LLM_ANTHROPIC_STREAM_DLP=buffer
LLM_ANTHROPIC_UAE_RESIDENT=false

# ---- manar-fleet integration (ADR-0010), all off by default ----
# Platform API (/platform/v1/*) for manar-fleet's tenant lifecycle. Unset = every platform route
# denies. Tokens: client-credentials client PLATFORM_API_CLIENT_ID in this realm, whose service
# account holds realm role PLATFORM_API_ROLE.
PLATFORM_API_ISSUER=
PLATFORM_API_CLIENT_ID=manar-fleet
PLATFORM_API_ROLE=manar-platform-admin
# Signed heartbeat to manar-fleet. Unset URL = nothing is sent. Key: `pnpm manar fleet:keygen`
# writes it to OpenBao KV at FLEET_HEARTBEAT_KEY_PATH and prints the public key to register.
FLEET_HEARTBEAT_URL=
FLEET_DEPLOYMENT_ID=
FLEET_HEARTBEAT_INTERVAL_MINUTES=5
FLEET_HEARTBEAT_KEY_PATH=fleet/heartbeat-signing-key
# JSON written by the backup job: {"status":"ok","lastBackupAt":"...","lastRestoreTestAt":"..."}
FLEET_BACKUP_STATUS_FILE=

# ---- Licence (docs/licensing.md): soft limits, nothing is ever blocked ----
# A licence file path (wins) or the licence inline. Unset = status "missing".
MANAR_LICENSE_FILE=
MANAR_LICENSE=
# hosted or customer, used when no licence is verified. Local development runs as hosted, so the
# console shows no "no licence" banner.
MANAR_DEPLOYMENT=hosted

# ---- Public MCP endpoint for cloud agents (docs/cloud-agents.md), off by default ----
# MANAR_MCP_HOST is the public host only (no scheme); MCP URLs are https://<host>/mcp/<tenant>/<agent>.
MANAR_MCP_ENABLED=false
MANAR_MCP_HOST=
MANAR_MCP_DCR_TRUSTED_HOSTS=chatgpt.com
# Shared hosted realm for tenants with no realm of their own; their agent scopes/clients carry the
# tenant id and the token carries the `manar_tenant` claim. Unset on customer-hosted installs.
MANAR_MCP_SHARED_ISSUER=
# ChatGPT (dynamic client registration) on the shared realm: on unless set to false.
MANAR_MCP_CHATGPT_ENABLED=true
MANAR_MCP_RATE_LIMIT_PER_MINUTE=60
MANAR_MCP_MAX_BODY_BYTES=262144
# Reverse proxies in front of the HTTP app (cloudflared, Traefik pod ranges), comma-separated
# addresses or CIDRs; request.ip then comes from their X-Forwarded-For chain. `none` = exposed
# directly. Required when MANAR_MCP_ENABLED is true.
MANAR_TRUSTED_PROXY_CIDRS=
# ---- Manar edge (docs/edge.md), off by default ----
# WireGuard gateway every governed agent's network path goes through. With MANAR_EDGE_ENABLED=true
# the next four are required (startup stops otherwise). MANAR_EDGE_GATEWAY_TOKEN is a secret
# (OpenBao kv/prod/manar-edge gateway_token), at least 32 characters.
MANAR_EDGE_ENABLED=false
MANAR_EDGE_CIDR=100.88.0.0/16
# MANAR_EDGE_ENDPOINT=edge.example.com:51820
# MANAR_EDGE_GATEWAY_PUBLIC_KEY=
# MANAR_EDGE_GATEWAY_TOKEN=
# MANAR_AGENTS_HOST=agents.example.com
# ---- Billing (docs/billing.md). Stripe off until STRIPE_SECRET_KEY is set ----
# ExternalSecrets deliver STRIPE_SECRET_KEY (a restricted key, rk_) and STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_COMPANY_USER=price_...
# STRIPE_PRICE_EXTRA_DEVICE=price_...
# Console base URL for Checkout return links and the upgrade link in plan-limit errors.
BILLING_CONSOLE_URL=http://localhost:3001

# Features track: set to false to disable the Sunday-night weekly report card job (worker only).
REPORT_CARD_WEEKLY_JOB=true
# "Add device" one-liner (docs/hosts.md). All public information; delivered as plain Helm values.
# Unset URLs default to the hosted install. With no MANAR_EDGE_VERSION the install scripts say
# the installer is not available yet. Checksums come from the release's SHA256SUMS.
# MANAR_CONSOLE_URL=https://console-manar.vax.sh
# MANAR_HOST_URL=https://agents-manar.vax.sh:3443
# MANAR_EDGE_VERSION=v0.1.0
# MANAR_EDGE_RELEASE_BASE=https://github.com/manarhq/manar-edge/releases/download
# MANAR_EDGE_SHA256_WINDOWS_AMD64=
# MANAR_EDGE_SHA256_LINUX_AMD64=
# MANAR_EDGE_SHA256_LINUX_ARM64=

# Features track: set to false to disable the Sunday-night weekly report card job (worker only).
REPORT_CARD_WEEKLY_JOB=true

# Web Push for approvals (spec 4.6). Optional; all three together or none. In the cluster they come
# from the ExternalSecret that fills the chart's `secrets.data`. Generate a pair with
# `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com

# Telegram approvals bot (phone track). Optional; off without the token. The token and the webhook
# secret are ExternalSecret keys; the secret is 32+ random characters of A-Z a-z 0-9 _ -.
# TELEGRAM_BOT_USERNAME has no @. TELEGRAM_WEBHOOK_URL is the public https URL of
# POST /telegram/webhook; when set, the API registers it with Telegram at start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=

# Guard track: Undo AI file changes. Devices snapshot files an AI tool edits outside its project
# folder (metadata only reaches Manar). Set to false to remove `undo` from GET /host/v1/config.
HOST_UNDO_ENABLED=true
