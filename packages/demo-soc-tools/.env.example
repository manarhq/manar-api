# Copy to .env for local development of this service.
#
# Standalone Phase 7a demo SOC tool backend — no dependency on the root
# manar-api .env. See ../../docs/superpowers/specs/2026-08-19-phase7a-demo-soc-tools-design.md.

PORT=3100
NODE_ENV=development
LOG_LEVEL=info

# Single static bearer token every /v1/* request must present as
# `Authorization: Bearer <token>`. In the real deployment (deploy/docker-compose.yml)
# this is the credential Phase 7b's CredentialBrokerService fetches from
# OpenBao and injects — never seen directly by any agent.
DEMO_TOOLS_API_KEY=demo-tools-local-dev-key
